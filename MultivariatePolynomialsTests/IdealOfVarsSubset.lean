module

import MultivariatePolynomials.IdealOfVars
import Mathlib.Algebra.Ring.Parity
import Mathlib.Data.ZMod.Basic

/-!
# Ideals generated by subsets of variables

These examples describe the variable ideals generated by the even natural-number
indices over `ZMod 6` and `ZMod 1`, and by finite or empty subsets in the same
infinite ambient variable type. The all-variable examples relate the subset span
to `idealOfVars` and its finite- and infinite-variable cases.

## References

* `MultivariatePolynomials.IdealOfVars`: finite generation of variable ideals.
* Mathlib's `Mathlib.RingTheory.MvPolynomial.Ideal`: `idealOfVars`,
  `idealOfVars_fg`, and the membership criterion `mem_ideal_span_X_image`.
* Mathlib's `Mathlib.Data.ZMod.Basic`: coefficient rings with zero divisors
  and with one element.
-/

universe u v

private instance : Nontrivial (ZMod 6) :=
  ZMod.nontrivial_iff.mpr (by decide)

private theorem even_indices_infinite : {n : ℕ | Even n}.Infinite := by
  refine Set.infinite_of_injective_forall_mem (f := fun n : ℕ => 2 * n) ?_ ?_
  · intro m n h
    exact Nat.mul_left_cancel (by decide : 0 < 2) h
  · intro n
    exact even_two_mul n

private theorem one_notMem_variable_span
    {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] (S : Set σ) :
    (1 : MvPolynomial σ R) ∉
      Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' S) := by
  classical
  rw [MvPolynomial.mem_ideal_span_X_image, MvPolynomial.support_one]
  simp

private theorem even_variable_span_zmod_one_eq_bot :
    Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 1)) ''
      {n : ℕ | Even n}) = ⊥ := by
  let : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
  apply le_antisymm
  · intro p _
    exact Ideal.mem_bot.mpr (Subsingleton.elim p 0)
  · exact bot_le

-- All-variable specialization and recovery of the infinite-variable statement.
example {σ : Type u} {R : Type v} [CommSemiring R] :
    Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' Set.univ) =
      MvPolynomial.idealOfVars σ R := by
  simp only [Set.image_univ, MvPolynomial.idealOfVars]

example {σ : Type u} {R : Type v} [CommSemiring R] [Finite σ] :
    (Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' Set.univ)).FG := by
  simpa only [Set.image_univ, MvPolynomial.idealOfVars] using
    MvPolynomial.idealOfVars_fg σ R

example {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] [Infinite σ] :
    ¬ (MvPolynomial.idealOfVars σ R).FG := by
  intro hfg
  have hfinite : (Set.univ : Set σ).Finite :=
    (MvPolynomial.ideal_span_X_image_fg_iff (R := R) Set.univ).mp
      (by simpa only [Set.image_univ, MvPolynomial.idealOfVars] using hfg)
  exact Set.infinite_univ hfinite

-- The coefficient hypotheses allow zero divisors.
example : Nontrivial (ZMod 6) := by
  infer_instance

example : (2 : ZMod 6) ≠ 0 ∧ (3 : ZMod 6) ≠ 0 ∧ (2 : ZMod 6) * 3 = 0 := by
  decide

-- The even indices form an inhabited, proper infinite subset.
example : {n : ℕ | Even n}.Infinite ∧ {n : ℕ | Even n} ≠ Set.univ := by
  refine ⟨even_indices_infinite, ?_⟩
  intro h
  have hone : (1 : ℕ) ∈ {n : ℕ | Even n} := by
    rw [h]
    exact Set.mem_univ 1
  exact (by decide : ¬ Even (1 : ℕ)) hone

example : (0 : ℕ) ∈ {n : ℕ | Even n} ∧ (1 : ℕ) ∉ {n : ℕ | Even n} := by
  decide

example :
    ¬ (Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
      {n : ℕ | Even n})).FG := by
  intro hfg
  exact even_indices_infinite
    ((MvPolynomial.ideal_span_X_image_fg_iff (R := ZMod 6) {n : ℕ | Even n}).mp hfg)

example :
    (MvPolynomial.X 0 : MvPolynomial ℕ (ZMod 6)) ∈
      Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
        {n : ℕ | Even n}) := by
  exact Ideal.subset_span ⟨0, by decide, rfl⟩

example :
    (MvPolynomial.X 1 : MvPolynomial ℕ (ZMod 6)) ∉
      Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
        {n : ℕ | Even n}) := by
  intro hx
  obtain ⟨i, hi, hnonzero⟩ := MvPolynomial.mem_ideal_span_X_image.mp hx
    (Finsupp.single 1 1) (by simp [MvPolynomial.support_X])
  have hi_eq : i = 1 := (Finsupp.single_apply_ne_zero.mp hnonzero).1
  subst i
  exact (by decide : ¬ Even (1 : ℕ)) hi

example :
    (1 : MvPolynomial ℕ (ZMod 6)) ∉
      Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
        {n : ℕ | Even n}) := by
  exact one_notMem_variable_span _

-- A finite subset gives a nonzero proper FG ideal despite infinitely many ambient variables.
example : ({0, 2, 4} : Set ℕ).Finite := by
  simp

example :
    (Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
      ({0, 2, 4} : Set ℕ))).FG := by
  apply (MvPolynomial.ideal_span_X_image_fg_iff (R := ZMod 6) _).mpr
  simp

example :
    Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
      ({0, 2, 4} : Set ℕ)) ≠ ⊥ ∧
    Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
      ({0, 2, 4} : Set ℕ)) ≠ ⊤ := by
  constructor
  · intro hbot
    have hx : (MvPolynomial.X 0 : MvPolynomial ℕ (ZMod 6)) ∈
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
          ({0, 2, 4} : Set ℕ)) :=
      Ideal.subset_span ⟨0, by simp, rfl⟩
    have hxzero : (MvPolynomial.X 0 : MvPolynomial ℕ (ZMod 6)) = 0 := by
      simpa only [hbot, Submodule.mem_bot] using hx
    exact MvPolynomial.X_ne_zero 0 hxzero
  · exact (Ideal.ne_top_iff_one _).mpr (one_notMem_variable_span _)

-- The empty subset gives the bottom ideal in the same ambient ring.
example :
    Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) '' (∅ : Set ℕ)) =
      ⊥ := by
  rw [Set.image_empty, Ideal.span_empty]

example :
    (Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 6)) ''
      (∅ : Set ℕ))).FG := by
  rw [Set.image_empty, Ideal.span_empty]
  exact Submodule.fg_bot

-- Nontriviality is essential for the converse, even with the same infinite subset.
example : (1 : ZMod 1) = 0 := by
  exact ZMod.one_eq_zero_iff.mpr rfl

example :
    Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 1)) ''
      {n : ℕ | Even n}) = ⊥ := by
  exact even_variable_span_zmod_one_eq_bot

example :
    (Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ZMod 1)) ''
      {n : ℕ | Even n})).FG ∧ ¬ {n : ℕ | Even n}.Finite := by
  constructor
  · rw [even_variable_span_zmod_one_eq_bot]
    exact Submodule.fg_bot
  · exact even_indices_infinite
