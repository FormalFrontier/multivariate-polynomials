module

import MultivariatePolynomials.IdealOfVars
import Mathlib.Algebra.Group.Int.Units
import Mathlib.Algebra.Ring.Prod
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Finiteness.Ideal

/-!
# Ideals generated by coefficients and selected variables

The examples distinguish unit and proper coefficient ideals, empty selected
sets, empty ambient variable types, finite and infinite selected sets, and
coefficients whose variable ideal is not finitely generated. The concrete
coefficient ideals include `(2)` in `ℤ`, the nonsubtractive ideal generated by
`2` and `3` in `ℕ`, and the proper idempotent ideal generated by `(1, 0)` in
`ℤ × ℤ`. Coefficients in `ZMod 1` give the zero-ring boundary.

## References

* `MultivariatePolynomials.IdealOfVars`: finite generation of coefficient and
  variable ideals and the infinite-variable ideal obstruction.
* Mathlib's ideal span, finite generation, integer units, product units, and
  `ZMod` APIs.
-/

@[expose] public section

universe u v

namespace MultivariatePolynomialsTests

private theorem int_two_fg_proper :
    (Ideal.span ({2} : Set ℤ)).FG ∧ Ideal.span ({2} : Set ℤ) ≠ ⊤ := by
  refine ⟨Submodule.fg_span (Set.finite_singleton 2), ?_⟩
  simp [Ideal.span_singleton_eq_top, Int.isUnit_iff]

private theorem nat_two_three_facts :
    (Ideal.span ({2, 3} : Set ℕ)).FG ∧
      Ideal.span ({2, 3} : Set ℕ) ≠ ⊤ ∧
      (2 : ℕ) ∈ Ideal.span ({2, 3} : Set ℕ) ∧
      (2 + 1 : ℕ) ∈ Ideal.span ({2, 3} : Set ℕ) ∧
      (1 : ℕ) ∉ Ideal.span ({2, 3} : Set ℕ) := by
  have hone : (1 : ℕ) ∉ Ideal.span ({2, 3} : Set ℕ) := by
    intro h
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp h
    omega
  refine ⟨Submodule.fg_span (by simp), (Ideal.ne_top_iff_one _).mpr hone, ?_, ?_, hone⟩
  · exact Ideal.subset_span (by simp)
  · exact Ideal.subset_span (by decide)

private theorem prod_idempotent_fg_proper :
    (Ideal.span ({(1, 0)} : Set (ℤ × ℤ))).FG ∧
      Ideal.span ({(1, 0)} : Set (ℤ × ℤ)) ≠ ⊤ := by
  refine ⟨Submodule.fg_span (Set.finite_singleton (1, 0)), ?_⟩
  simp [Ideal.span_singleton_eq_top, Prod.isUnit_iff]

-- The unit coefficient ideal allows every selected subset.
example {σ : Type u} {R : Type v} [CommSemiring R] (S : Set σ) :
    (Ideal.map (MvPolynomial.C : R →+* MvPolynomial σ R) (⊤ : Ideal R) ⊔
      Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' S)).FG := by
  exact (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff (⊤ : Ideal R) S).mpr
    ⟨Ideal.fg_top R, Or.inr rfl⟩

-- In particular, infinite selected sets do not obstruct the unit ideal.
example :
    ¬ (Set.univ : Set ℕ).Finite ∧
      Ideal.map (MvPolynomial.C : ℤ →+* MvPolynomial ℕ ℤ) (⊤ : Ideal ℤ) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℤ) '' Set.univ) = ⊤ ∧
      (Ideal.map (MvPolynomial.C : ℤ →+* MvPolynomial ℕ ℤ) (⊤ : Ideal ℤ) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℤ) '' Set.univ)).FG := by
  refine ⟨Set.infinite_univ, by simp [Ideal.map_top], ?_⟩
  exact (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff (⊤ : Ideal ℤ)
    (Set.univ : Set ℕ)).mpr ⟨Ideal.fg_top ℤ, Or.inr rfl⟩

-- An empty selected set retains exactly the coefficient finite-generation condition.
example {σ : Type u} {R : Type v} [CommSemiring R] (I : Ideal R) :
    (Ideal.map (MvPolynomial.C : R →+* MvPolynomial σ R) I).FG ↔ I.FG := by
  simpa only [Set.image_empty, Ideal.span_empty, sup_bot_eq, Set.finite_empty,
    true_or, and_true] using
    MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff I (∅ : Set σ)

-- With bottom coefficients and a nontrivial base, recover the variable-subset criterion.
example {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] (S : Set σ) :
    (Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' S)).FG ↔ S.Finite := by
  have hbotFG : (⊥ : Ideal R).FG := Submodule.fg_bot
  have hbotProper : (⊥ : Ideal R) ≠ ⊤ := bot_ne_top
  simpa only [Ideal.map_bot, bot_sup_eq, hbotFG, true_and, hbotProper, or_false] using
    MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff (⊥ : Ideal R) S

-- A proper principal coefficient ideal allows finite selected sets in an infinite ambient type.
example :
    (Ideal.span ({2} : Set ℤ)).FG ∧ Ideal.span ({2} : Set ℤ) ≠ ⊤ ∧
      ({0, 2, 4} : Set ℕ).Finite ∧
      (Ideal.map (MvPolynomial.C : ℤ →+* MvPolynomial ℕ ℤ)
          (Ideal.span ({2} : Set ℤ)) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℤ) ''
          ({0, 2, 4} : Set ℕ))).FG := by
  obtain ⟨hfg, hproper⟩ := int_two_fg_proper
  have hS : ({0, 2, 4} : Set ℕ).Finite := by simp
  exact ⟨hfg, hproper, hS,
    (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff _ _).mpr ⟨hfg, Or.inl hS⟩⟩

example :
    (Set.univ : Set ℕ).Infinite ∧
      ¬ (Ideal.map (MvPolynomial.C : ℤ →+* MvPolynomial ℕ ℤ)
          (Ideal.span ({2} : Set ℤ)) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℤ) '' Set.univ)).FG := by
  refine ⟨Set.infinite_univ, ?_⟩
  intro hfg
  have h := (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff
    (Ideal.span ({2} : Set ℤ)) (Set.univ : Set ℕ)).mp hfg
  exact Set.infinite_univ (h.2.resolve_right int_two_fg_proper.2)

-- In the zero ring every coefficient ideal is the unit ideal, regardless of the selected set.
example {σ : Type u} (I : Ideal (ZMod 1)) (S : Set σ) :
    I = ⊤ ∧
      (Ideal.map (MvPolynomial.C : ZMod 1 →+* MvPolynomial σ (ZMod 1)) I ⊔
        Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ (ZMod 1)) '' S)).FG := by
  have hI : I = ⊤ := by
    apply (Ideal.eq_top_iff_one I).mpr
    rw [show (1 : ZMod 1) = 0 from Subsingleton.elim _ _]
    exact I.zero_mem
  refine ⟨hI, (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff I S).mpr
    ⟨?_, Or.inr hI⟩⟩
  rw [hI]
  exact Ideal.fg_top _

-- This proper semiring ideal is not subtractive: 2 and 2 + 1 belong, but 1 does not.
example :
    (Ideal.span ({2, 3} : Set ℕ)).FG ∧
      Ideal.span ({2, 3} : Set ℕ) ≠ ⊤ ∧
      (2 : ℕ) ∈ Ideal.span ({2, 3} : Set ℕ) ∧
      (2 + 1 : ℕ) ∈ Ideal.span ({2, 3} : Set ℕ) ∧
      (1 : ℕ) ∉ Ideal.span ({2, 3} : Set ℕ) ∧
      (Ideal.map (MvPolynomial.C : ℕ →+* MvPolynomial ℕ ℕ)
          (Ideal.span ({2, 3} : Set ℕ)) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℕ) ''
          ({0, 2, 4} : Set ℕ))).FG := by
  obtain ⟨hfg, hproper, htwo, hthree, hone⟩ := nat_two_three_facts
  refine ⟨hfg, hproper, htwo, hthree, hone, ?_⟩
  exact (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff _ _).mpr
    ⟨hfg, Or.inl (by simp)⟩

example :
    (Set.univ : Set ℕ).Infinite ∧
      ¬ (Ideal.map (MvPolynomial.C : ℕ →+* MvPolynomial ℕ ℕ)
          (Ideal.span ({2, 3} : Set ℕ)) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ ℕ) '' Set.univ)).FG := by
  refine ⟨Set.infinite_univ, ?_⟩
  intro hfg
  have h := (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff
    (Ideal.span ({2, 3} : Set ℕ)) (Set.univ : Set ℕ)).mp hfg
  exact Set.infinite_univ (h.2.resolve_right nat_two_three_facts.2.1)

-- A coefficient ideal that is not FG remains so even with no selected outer variables.
example :
    ¬ (MvPolynomial.idealOfVars ℕ ℤ).FG ∧
      ¬ (Ideal.map
          (MvPolynomial.C : MvPolynomial ℕ ℤ →+* MvPolynomial ℕ (MvPolynomial ℕ ℤ))
          (MvPolynomial.idealOfVars ℕ ℤ) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (MvPolynomial ℕ ℤ)) ''
          (∅ : Set ℕ))).FG := by
  have hI := MvPolynomial.idealOfVars_not_fg ℤ ℕ
  refine ⟨hI, ?_⟩
  intro hfg
  exact hI ((MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff
    (MvPolynomial.idealOfVars ℕ ℤ) (∅ : Set ℕ)).mp hfg).1

-- With an empty ambient variable type, every selected set is finite.
example {R : Type v} [CommSemiring R] (I : Ideal R) (S : Set (Fin 0)) :
    (Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 0) R) I ⊔
      Ideal.span ((MvPolynomial.X : Fin 0 → MvPolynomial (Fin 0) R) '' S)).FG ↔
        I.FG := by
  have hS : S.Finite := S.toFinite
  simpa only [hS, true_or, and_true] using
    MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff I S

-- A proper idempotent coefficient ideal in a ring with zero divisors also allows finite S.
example :
    (Ideal.span ({(1, 0)} : Set (ℤ × ℤ))).FG ∧
      Ideal.span ({(1, 0)} : Set (ℤ × ℤ)) ≠ ⊤ ∧
      Ideal.span ({(1, 0)} : Set (ℤ × ℤ)) *
          Ideal.span ({(1, 0)} : Set (ℤ × ℤ)) =
        Ideal.span ({(1, 0)} : Set (ℤ × ℤ)) ∧
      ((1, 0) : ℤ × ℤ) ≠ 0 ∧ ((0, 1) : ℤ × ℤ) ≠ 0 ∧
      ((1, 0) : ℤ × ℤ) * (0, 1) = 0 ∧
      (Ideal.map (MvPolynomial.C : ℤ × ℤ →+* MvPolynomial ℕ (ℤ × ℤ))
          (Ideal.span ({(1, 0)} : Set (ℤ × ℤ))) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ℤ × ℤ)) ''
          ({0, 2, 4} : Set ℕ))).FG := by
  obtain ⟨hfg, hproper⟩ := prod_idempotent_fg_proper
  refine ⟨hfg, hproper, ?_, by decide, by decide, by decide, ?_⟩
  · rw [Ideal.span_singleton_mul_span_singleton]
    rfl
  · exact (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff _ _).mpr
      ⟨hfg, Or.inl (by simp)⟩

example :
    (Set.univ : Set ℕ).Infinite ∧
      ¬ (Ideal.map (MvPolynomial.C : ℤ × ℤ →+* MvPolynomial ℕ (ℤ × ℤ))
          (Ideal.span ({(1, 0)} : Set (ℤ × ℤ))) ⊔
        Ideal.span ((MvPolynomial.X : ℕ → MvPolynomial ℕ (ℤ × ℤ)) '' Set.univ)).FG := by
  refine ⟨Set.infinite_univ, ?_⟩
  intro hfg
  have h := (MvPolynomial.ideal_map_C_sup_span_X_image_fg_iff
    (Ideal.span ({(1, 0)} : Set (ℤ × ℤ))) (Set.univ : Set ℕ)).mp hfg
  exact Set.infinite_univ (h.2.resolve_right prod_idempotent_fg_proper.2)

end MultivariatePolynomialsTests
