module

import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.FiniteType
import MultivariatePolynomials.Noetherian

/-!
# Relative finite type of variable renaming: examples

The algebra base in these examples is the source polynomial semiring, acting
on the target through the renaming homomorphism. It is not the coefficient
semiring. The projection from paired natural variables is surjective despite
collisions, and the successor map needs just the additional generator `X 0`.
Both have infinitely many source and target variables and use the non-ring
coefficient semiring `ℕ`.

Empty source and target variable types may lie in independent universes. With
zero coefficients, an empty source can have infinitely many missed target
variables while the target algebra is generated by the empty set. In contrast,
over the nonreduced ring `ZMod 4`, the map from one variable to infinitely many
variables sending its variable to `X 0` is not of finite type.

## References

* Mathlib, `Mathlib.RingTheory.FiniteType`: finite generation of algebras,
  transfer along surjective algebra homomorphisms, and the Noetherian consequence
  for commutative rings.
* Mathlib, `Mathlib.Algebra.MvPolynomial.Rename`: variable renaming and its
  surjectivity for surjective variable maps.
* Mathlib, `Mathlib.Algebra.MvPolynomial.Basic` and
  `Mathlib.RingTheory.Adjoin.FG`: polynomial induction and finite algebra generators.
* `MultivariatePolynomials.Noetherian`: Noetherianity of a polynomial semiring
  over nontrivial coefficients forces finitely many variables.
-/

universe u v w

namespace MultivariatePolynomialsTests

private theorem nat_coefficients_have_no_additive_inverse :
    ¬ ∃ n : ℕ, 1 + n = 0 := by
  rintro ⟨n, hn⟩
  exact Nat.succ_ne_zero n (by simpa only [Nat.add_comm] using hn)

private theorem paired_projection_surjective :
    Function.Surjective (Prod.fst : ℕ × Bool → ℕ) := by
  intro n
  exact ⟨(n, false), rfl⟩

private theorem paired_projection_not_injective :
    ¬ Function.Injective (Prod.fst : ℕ × Bool → ℕ) := by
  intro h
  have hfalse : false = true := congrArg Prod.snd
    (h (show Prod.fst (0, false) = Prod.fst (0, true) from rfl))
  cases hfalse

private theorem paired_projection_missed_targets_empty :
    (Set.range (Prod.fst : ℕ × Bool → ℕ))ᶜ = ∅ := by
  rw [Set.range_eq_univ.mpr paired_projection_surjective, Set.compl_univ]

private theorem paired_projection_finiteType :
    @Algebra.FiniteType (MvPolynomial (ℕ × Bool) ℕ) (MvPolynomial ℕ ℕ) _ _
      (MvPolynomial.rename (R := ℕ) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra := by
  let : Algebra (MvPolynomial (ℕ × Bool) ℕ) (MvPolynomial ℕ ℕ) :=
    (MvPolynomial.rename (R := ℕ) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra
  exact Algebra.FiniteType.of_surjective
    (Algebra.ofId (MvPolynomial (ℕ × Bool) ℕ) (MvPolynomial ℕ ℕ))
    (MvPolynomial.rename_surjective _ paired_projection_surjective)

private theorem successor_missed_targets_singleton :
    (Set.range Nat.succ)ᶜ = ({0} : Set ℕ) := by
  ext n
  cases n <;> simp

-- All positive-index variables are scalar images; only X 0 is adjoined.
private theorem successor_finiteType :
    @Algebra.FiniteType (MvPolynomial ℕ ℕ) (MvPolynomial ℕ ℕ) _ _
      (MvPolynomial.rename (R := ℕ) Nat.succ).toRingHom.toAlgebra := by
  let : Algebra (MvPolynomial ℕ ℕ) (MvPolynomial ℕ ℕ) :=
    (MvPolynomial.rename (R := ℕ) Nat.succ).toRingHom.toAlgebra
  refine ⟨⟨{(MvPolynomial.X 0 : MvPolynomial ℕ ℕ)}, ?_⟩⟩
  rw [Finset.coe_singleton]
  let S : Subalgebra (MvPolynomial ℕ ℕ) (MvPolynomial ℕ ℕ) :=
    Algebra.adjoin (MvPolynomial ℕ ℕ) ({MvPolynomial.X 0} : Set (MvPolynomial ℕ ℕ))
  change S = ⊤
  apply top_unique
  intro p _hp
  clear _hp
  induction p using MvPolynomial.induction_on with
  | C r =>
      have hr := S.algebraMap_mem (MvPolynomial.C r)
      change MvPolynomial.rename Nat.succ (MvPolynomial.C r) ∈ S at hr
      simpa only [MvPolynomial.rename_C] using hr
  | add p q hp hq => exact S.add_mem hp hq
  | mul_X p n hp =>
      apply S.mul_mem hp
      cases n with
      | zero => exact Algebra.subset_adjoin (Set.mem_singleton_iff.mpr rfl)
      | succ n =>
          have hn := S.algebraMap_mem (MvPolynomial.X n)
          change MvPolynomial.rename Nat.succ (MvPolynomial.X n) ∈ S at hn
          simpa only [MvPolynomial.rename_X] using hn

private theorem empty_rename_finiteType {R : Type u} [CommSemiring R] :
    @Algebra.FiniteType (MvPolynomial PEmpty.{v + 1} R)
      (MvPolynomial PEmpty.{w + 1} R) _ _
      (MvPolynomial.rename (R := R)
        (PEmpty.elim : PEmpty.{v + 1} → PEmpty.{w + 1})).toRingHom.toAlgebra := by
  let : Algebra (MvPolynomial PEmpty.{v + 1} R) (MvPolynomial PEmpty.{w + 1} R) :=
    (MvPolynomial.rename (R := R)
      (PEmpty.elim : PEmpty.{v + 1} → PEmpty.{w + 1})).toRingHom.toAlgebra
  exact Algebra.FiniteType.of_surjective
    (Algebra.ofId (MvPolynomial PEmpty.{v + 1} R) (MvPolynomial PEmpty.{w + 1} R))
    (MvPolynomial.rename_surjective _ (fun x => PEmpty.elim x))

private theorem zero_coefficients_empty_source_finiteType :
    @Algebra.FiniteType (MvPolynomial PEmpty.{v + 1} (ZMod 1))
      (MvPolynomial ℕ (ZMod 1)) _ _
      (MvPolynomial.rename (R := ZMod 1)
        (PEmpty.elim : PEmpty.{v + 1} → ℕ)).toRingHom.toAlgebra := by
  let : Algebra (MvPolynomial PEmpty.{v + 1} (ZMod 1)) (MvPolynomial ℕ (ZMod 1)) :=
    (MvPolynomial.rename (R := ZMod 1)
      (PEmpty.elim : PEmpty.{v + 1} → ℕ)).toRingHom.toAlgebra
  refine ⟨⟨∅, ?_⟩⟩
  rw [Finset.coe_empty]
  apply top_unique
  intro p _hp
  have hp : p = 0 := Subsingleton.elim _ _
  rw [hp]
  exact (Algebra.adjoin (MvPolynomial PEmpty.{v + 1} (ZMod 1))
    (∅ : Set (MvPolynomial ℕ (ZMod 1)))).zero_mem

private theorem empty_source_missed_targets_infinite :
    Set.Infinite ((Set.range (PEmpty.elim : PEmpty.{v + 1} → ℕ))ᶜ) := by
  have hr : Set.range (PEmpty.elim : PEmpty.{v + 1} → ℕ) = ∅ := by
    ext n
    constructor
    · rintro ⟨i, _hi⟩
      exact PEmpty.elim i
    · intro hn
      exact hn.elim
  rw [hr, Set.compl_empty]
  exact Set.infinite_univ

private theorem zmod_four_nonzero_nilpotent :
    (2 : ZMod 4) ≠ 0 ∧ (2 : ZMod 4) ^ 2 = 0 := by
  decide

private theorem singleton_source_missed_targets_infinite :
    Set.Infinite ((Set.range (fun _ : Fin 1 => (0 : ℕ)))ᶜ) := by
  intro h
  have hu : (Set.univ : Set ℕ).Finite := by
    simpa only [Set.union_compl_self] using
      (Set.finite_range (fun _ : Fin 1 => (0 : ℕ))).union h
  exact Set.infinite_univ hu

private theorem singleton_source_zmod_four_not_finiteType :
    ¬ @Algebra.FiniteType (MvPolynomial (Fin 1) (ZMod 4)) (MvPolynomial ℕ (ZMod 4)) _ _
      (MvPolynomial.rename (R := ZMod 4) (fun _ : Fin 1 => (0 : ℕ))).toRingHom.toAlgebra := by
  intro h
  let : Algebra (MvPolynomial (Fin 1) (ZMod 4)) (MvPolynomial ℕ (ZMod 4)) :=
    (MvPolynomial.rename (R := ZMod 4) (fun _ : Fin 1 => (0 : ℕ))).toRingHom.toAlgebra
  let : Algebra.FiniteType (MvPolynomial (Fin 1) (ZMod 4)) (MvPolynomial ℕ (ZMod 4)) := h
  let : IsNoetherianRing (ZMod 4) := isNoetherian_of_finite (ZMod 4) (ZMod 4)
  let : Nontrivial (ZMod 4) := ZMod.nontrivial_iff.mpr (by decide)
  let : IsNoetherianRing (MvPolynomial ℕ (ZMod 4)) :=
    Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin 1) (ZMod 4))
      (MvPolynomial ℕ (ZMod 4))
  exact Infinite.not_finite
    (MvPolynomial.finite_of_isNoetherianRing (σ := ℕ) (R := ZMod 4))

end MultivariatePolynomialsTests
