module

public import MultivariatePolynomials.CoefficientIdeal
public import MultivariatePolynomials.Primary
public import Mathlib.RingTheory.Ideal.Int
public import Mathlib.RingTheory.Ideal.IsPrimary
public import Mathlib.Algebra.MvPolynomial.NoZeroDivisors
public import Mathlib.Tactic.NormNum

/-!
# The coefficient ideal generated by four

The ideal generated by four in the integers is primary.
Over the integers, the square of `2 * X` lies in the extension of `(4)`,
although `2 * X` does not. The extension is proper and `2 * X` is nonzero.
-/

@[expose] public section

/-- The ideal generated by four in the integers is primary. -/
theorem Int.isPrimary_span_four :
    (Ideal.span ({(4 : ℤ)} : Set ℤ)).IsPrimary := by
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  have htwo : (Ideal.span ({(2 : ℤ)} : Set ℤ)).IsMaximal :=
    Int.ideal_span_isMaximal_of_prime 2
  apply Ideal.isPrimary_of_isMaximal_radical
  rw [show (4 : ℤ) = 2 ^ 2 by decide, ← Ideal.span_singleton_pow,
    Ideal.radical_pow _ (by decide), htwo.isPrime.radical]
  exact htwo

namespace MvPolynomial

/-- The square of `2 * X` belongs to the extension of `(4)` over the integers,
while `2 * X` and `1` do not, and `2 * X` is nonzero. -/
theorem twice_X_span_four_facts :
    (C 2 * X () : MvPolynomial Unit ℤ) ^ 2 ∈ Ideal.map C (Ideal.span ({4} : Set ℤ)) ∧
      (C 2 * X () : MvPolynomial Unit ℤ) ∉ Ideal.map C (Ideal.span ({4} : Set ℤ)) ∧
      (1 : MvPolynomial Unit ℤ) ∉ Ideal.map C (Ideal.span ({4} : Set ℤ)) ∧
      (C 2 * X () : MvPolynomial Unit ℤ) ≠ 0 := by
  have h2 : (2 : ℤ) ∉ Ideal.span ({4} : Set ℤ) := by
    norm_num [Ideal.mem_span_singleton]
  have h1 : (1 : ℤ) ∉ Ideal.span ({4} : Set ℤ) := by
    norm_num [Ideal.mem_span_singleton]
  have hP : (C 2 * X () : MvPolynomial Unit ℤ) ∉
      Ideal.map C (Ideal.span ({4} : Set ℤ)) := by
    intro hp
    have hc := (mem_map_C_iff_coeff_mem.mp hp) (Finsupp.single () 1)
    exact h2 (by simpa only [coeff_C_mul, coeff_X_same, mul_one] using hc)
  have hone : (1 : MvPolynomial Unit ℤ) ∉
      Ideal.map C (Ideal.span ({4} : Set ℤ)) := by
    intro hp
    have hc := (mem_map_C_iff_coeff_mem.mp hp) 0
    exact h1 (by simpa using hc)
  refine ⟨?_, hP, hone, ?_⟩
  · have h4 : (4 : ℤ) ∈ Ideal.span ({4} : Set ℤ) := Ideal.subset_span (by simp)
    simpa only [mul_pow, ← map_pow, show (2 : ℤ) ^ 2 = 4 by norm_num] using
      (Ideal.map (C : ℤ →+* MvPolynomial Unit ℤ) (Ideal.span ({4} : Set ℤ))).mul_mem_right
        ((X () : MvPolynomial Unit ℤ) ^ 2) (Ideal.mem_map_of_mem C h4)
  · intro hzero
    apply hP
    rw [hzero]
    exact (Ideal.map C (Ideal.span ({4} : Set ℤ))).zero_mem

universe u v

section

variable {R : Type u} {σ : Type v} [CommRing R]

example (I : Ideal R) :
    I.IsPrimary ↔ I ≠ ⊤ ∧
      ∀ {x y : R}, x * y ∈ I → x ∈ I ∨ y ∈ I.radical :=
  Ideal.isPrimary_iff

example :
    ¬ (Ideal.map (C : R →+* MvPolynomial σ R) (⊤ : Ideal R)).IsPrimary := by
  rw [Ideal.map_top]
  exact fun h => (Ideal.isPrimary_iff.mp h).1 rfl

end

example :
    (Ideal.map (C : ℤ →+* MvPolynomial PEmpty ℤ) (⊥ : Ideal ℤ)).IsPrimary := by
  rw [Ideal.map_bot]
  exact (Ideal.isPrime_bot : (⊥ : Ideal (MvPolynomial PEmpty ℤ)).IsPrime).isPrimary

/-- The primary extension theorem applies to the fixed ideal `(4)` over `ℤ`. -/
example :
    (Ideal.map (C : ℤ →+* MvPolynomial Unit ℤ)
      (Ideal.span ({4} : Set ℤ))).IsPrimary :=
  (isPrimary_map_C_iff _).mpr Int.isPrimary_span_four

end MvPolynomial
