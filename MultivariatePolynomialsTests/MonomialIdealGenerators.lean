module

public import MultivariatePolynomials.MonomialIdeal
public import Mathlib.Basic.Complex.Basic

/-!
# The coordinate-axes monomial ideal in three variables

The ideal `(xy, xz, yz)` in `ℂ[x, y, z]` is the standard ideal of the union of
three coordinate axes. Its three exponents form a finite antichain for the
componentwise order. This file records that exponent set, its cardinality,
and its monomial presentation, together with nonzeroness and properness of
the ideal.

## References

* `MultivariatePolynomials.MonomialIdeal` for antichains of monomial generators.
* Mathlib, `Mathlib.RingTheory.MvPolynomial.Ideal`, for monomial-ideal membership.
-/

@[expose] public section

noncomputable section

namespace MvPolynomial.CoordinateAxes

/-- The exponent of `xy`. -/
def exponent01 : Fin 3 →₀ ℕ :=
  Finsupp.single 0 1 + Finsupp.single 1 1

/-- The exponent of `xz`. -/
def exponent02 : Fin 3 →₀ ℕ :=
  Finsupp.single 0 1 + Finsupp.single 2 1

/-- The exponent of `yz`. -/
def exponent12 : Fin 3 →₀ ℕ :=
  Finsupp.single 1 1 + Finsupp.single 2 1

/-- The three quadratic exponents, as a finite set. -/
def exponents : Finset (Fin 3 →₀ ℕ) := by
  classical
  exact {exponent01, exponent02, exponent12}

/-- The canonical set underlying `exponents`. -/
def exponentSet : Set (Fin 3 →₀ ℕ) :=
  (exponents : Set (Fin 3 →₀ ℕ))

/-- Membership in the exponent set is one of the three displayed choices. -/
theorem mem_exponentSet {s : Fin 3 →₀ ℕ} :
    s ∈ exponentSet ↔ s = exponent01 ∨ s = exponent02 ∨ s = exponent12 := by
  classical
  simp [exponentSet, exponents]

/-- The exponent set is finite. -/
theorem exponentSet_finite : exponentSet.Finite :=
  exponents.finite_toSet

private theorem exponent01_not_le_exponent02 : ¬ exponent01 ≤ exponent02 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent01, exponent02, Finsupp.single_apply] using h 1)

private theorem exponent01_not_le_exponent12 : ¬ exponent01 ≤ exponent12 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent01, exponent12, Finsupp.single_apply] using h 0)

private theorem exponent02_not_le_exponent01 : ¬ exponent02 ≤ exponent01 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent02, exponent01, Finsupp.single_apply] using h 2)

private theorem exponent02_not_le_exponent12 : ¬ exponent02 ≤ exponent12 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent02, exponent12, Finsupp.single_apply] using h 0)

private theorem exponent12_not_le_exponent01 : ¬ exponent12 ≤ exponent01 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent12, exponent01, Finsupp.single_apply] using h 2)

private theorem exponent12_not_le_exponent02 : ¬ exponent12 ≤ exponent02 := by
  intro h
  exact Nat.not_succ_le_zero 0 (by
    simpa [exponent12, exponent02, Finsupp.single_apply] using h 1)

/-- Distinct exponents in the set are incomparable in the pointwise order. -/
theorem exponentSet_isAntichain : IsAntichain (· ≤ ·) exponentSet := by
  intro a ha b hb hne hle
  rcases mem_exponentSet.mp ha with rfl | rfl | rfl <;>
    rcases mem_exponentSet.mp hb with rfl | rfl | rfl
  · exact hne rfl
  · exact exponent01_not_le_exponent02 hle
  · exact exponent01_not_le_exponent12 hle
  · exact exponent02_not_le_exponent01 hle
  · exact hne rfl
  · exact exponent02_not_le_exponent12 hle
  · exact exponent12_not_le_exponent01 hle
  · exact exponent12_not_le_exponent02 hle
  · exact hne rfl

/-- The finite exponent set has exactly three elements. -/
theorem exponents_card : exponents.card = 3 := by
  classical
  have h01_02 : exponent01 ≠ exponent02 :=
    fun h => exponent01_not_le_exponent02 (le_of_eq h)
  have h01_12 : exponent01 ≠ exponent12 :=
    fun h => exponent01_not_le_exponent12 (le_of_eq h)
  have h02_12 : exponent02 ≠ exponent12 :=
    fun h => exponent02_not_le_exponent12 (le_of_eq h)
  simp [exponents, h01_02, h01_12, h02_12]

/-- The canonical exponent set has cardinality three. -/
theorem exponentSet_ncard : exponentSet.ncard = 3 := by
  simpa [exponentSet] using exponents_card

/-- The monomial ideal generated by the three canonical exponents over `ℂ`. -/
def ideal : Ideal (MvPolynomial (Fin 3) ℂ) :=
  Ideal.span ((fun s => monomial s (1 : ℂ)) '' exponentSet)

/-- The first monic monomial is `xy`. -/
theorem monomial_exponent01 :
    (monomial exponent01 (1 : ℂ) : MvPolynomial (Fin 3) ℂ) = X 0 * X 1 := by
  simp only [exponent01, X, monomial_mul_monomial, one_mul]

/-- The second monic monomial is `xz`. -/
theorem monomial_exponent02 :
    (monomial exponent02 (1 : ℂ) : MvPolynomial (Fin 3) ℂ) = X 0 * X 2 := by
  simp only [exponent02, X, monomial_mul_monomial, one_mul]

/-- The third monic monomial is `yz`. -/
theorem monomial_exponent12 :
    (monomial exponent12 (1 : ℂ) : MvPolynomial (Fin 3) ℂ) = X 1 * X 2 := by
  simp only [exponent12, X, monomial_mul_monomial, one_mul]

/-- The image of the exponent set consists of the three quadratic products. -/
theorem monomial_image_exponentSet :
    ((fun s => monomial s (1 : ℂ)) '' exponentSet) =
      ({X 0 * X 1, X 0 * X 2, X 1 * X 2} : Set (MvPolynomial (Fin 3) ℂ)) := by
  ext p
  constructor
  · rintro ⟨s, hs, rfl⟩
    rcases mem_exponentSet.mp hs with rfl | rfl | rfl <;>
      simp [monomial_exponent01, monomial_exponent02, monomial_exponent12]
  · intro hp
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
    rcases hp with rfl | rfl | rfl
    · exact ⟨exponent01, mem_exponentSet.mpr (Or.inl rfl), monomial_exponent01⟩
    · exact ⟨exponent02, mem_exponentSet.mpr (Or.inr (Or.inl rfl)),
        monomial_exponent02⟩
    · exact ⟨exponent12, mem_exponentSet.mpr (Or.inr (Or.inr rfl)),
        monomial_exponent12⟩

/-- The usual ideal `(xy, xz, yz)` is the monomial ideal defined above. -/
theorem span_X_mul_X_eq_ideal :
    Ideal.span ({X 0 * X 1, X 0 * X 2, X 1 * X 2} :
      Set (MvPolynomial (Fin 3) ℂ)) = ideal := by
  rw [ideal, monomial_image_exponentSet]

/-- The coordinate-axes ideal is nonzero. -/
theorem ideal_ne_bot : ideal ≠ ⊥ := by
  have hmem : (monomial exponent01 (1 : ℂ) : MvPolynomial (Fin 3) ℂ) ∈ ideal := by
    apply Ideal.subset_span
    exact ⟨exponent01, mem_exponentSet.mpr (Or.inl rfl), rfl⟩
  intro h
  have hzero : (monomial exponent01 (1 : ℂ) : MvPolynomial (Fin 3) ℂ) = 0 := by
    simpa only [h, Ideal.mem_bot] using hmem
  have hcoeff : (1 : ℂ) = 0 := by
    simpa using congrArg (fun p : MvPolynomial (Fin 3) ℂ => p.coeff exponent01) hzero
  exact one_ne_zero hcoeff

/-- The unit polynomial does not belong to the coordinate-axes ideal. -/
theorem one_not_mem_ideal : (1 : MvPolynomial (Fin 3) ℂ) ∉ ideal := by
  intro h
  change (1 : MvPolynomial (Fin 3) ℂ) ∈
    Ideal.span ((fun s => monomial s (1 : ℂ)) '' exponentSet) at h
  obtain ⟨s, hs, hle⟩ :=
    mem_ideal_span_monomial_image.mp h 0 (by simp [support_one])
  rcases mem_exponentSet.mp hs with rfl | rfl | rfl
  · exact Nat.not_succ_le_zero 0 (by
      simpa [exponent01, Finsupp.single_apply] using hle 0)
  · exact Nat.not_succ_le_zero 0 (by
      simpa [exponent02, Finsupp.single_apply] using hle 0)
  · exact Nat.not_succ_le_zero 0 (by
      simpa [exponent12, Finsupp.single_apply] using hle 1)

/-- The coordinate-axes ideal is proper. -/
theorem ideal_ne_top : ideal ≠ ⊤ := by
  intro h
  apply one_not_mem_ideal
  rw [h]
  trivial

/- A concrete input in the usual coordinate-axes ideal: the public coefficient
map records the three distinct constant weights of `2xy + 3xz + 5yz`. -/
example :
    let w01 : exponentSet := ⟨exponent01, mem_exponentSet.mpr (Or.inl rfl)⟩
    let w02 : exponentSet := ⟨exponent02, mem_exponentSet.mpr (Or.inr (Or.inl rfl))⟩
    let w12 : exponentSet := ⟨exponent12, mem_exponentSet.mpr (Or.inr (Or.inr rfl))⟩
    let g (w : exponentSet) : Ideal.span ((fun s => monomial s (1 : ℂ)) '' exponentSet) :=
      ⟨monomial w.val (1 : ℂ), Ideal.subset_span ⟨w.val, w.property, rfl⟩⟩
    let p : Ideal.span ((fun s => monomial s (1 : ℂ)) '' exponentSet) :=
      (C (2 : ℂ) : MvPolynomial (Fin 3) ℂ) • g w01 +
      (C (3 : ℂ) : MvPolynomial (Fin 3) ℂ) • g w02 +
      (C (5 : ℂ) : MvPolynomial (Fin 3) ℂ) • g w12
    (p : MvPolynomial (Fin 3) ℂ) =
        C 2 * (X 0 * X 1) + C 3 * (X 0 * X 2) + C 5 * (X 1 * X 2) ∧
      (p : MvPolynomial (Fin 3) ℂ) ∈
        Ideal.span ({X 0 * X 1, X 0 * X 2, X 1 * X 2} :
          Set (MvPolynomial (Fin 3) ℂ)) ∧
      monomialIdealCoeffMap exponentSet_isAntichain p =
        Finsupp.single w01 (2 : ℂ) + Finsupp.single w02 (3 : ℂ) +
          Finsupp.single w12 (5 : ℂ) := by
  classical
  intro w01 w02 w12 g p
  refine ⟨?_, ?_, ?_⟩
  · change
      C (2 : ℂ) * monomial exponent01 1 +
        C (3 : ℂ) * monomial exponent02 1 +
        C (5 : ℂ) * monomial exponent12 1 = _
    rw [monomial_exponent01, monomial_exponent02, monomial_exponent12]
  · rw [span_X_mul_X_eq_ideal]
    exact p.property
  · have hg (w : exponentSet) :
        monomialIdealCoeffMap exponentSet_isAntichain (g w) =
          Finsupp.single w (1 : ℂ) :=
      monomialIdealCoeffMap_monomial exponentSet_isAntichain w
    simp only [p, map_add, map_smulₛₗ, constantCoeff_C, hg]
    simp

end MvPolynomial.CoordinateAxes
