module

import Mathlib.RingTheory.Ideal.NatInt
import MultivariatePolynomials.CoefficientIdealNat

/-!
# A radical ideal of natural numbers without subtractivity

The ideal generated by two and three in `ℕ` is radical, but membership of `a`
and `a + b` does not force membership of `b`. The witnesses are `a = 2` and `b = 1`.
Thus radicality of a coefficient ideal alone does not give the subtractivity
forced by a radical polynomial extension with a nonempty variable type.
For one variable, the extension of this maximal ideal is not radical.

## References

Mathlib's `Mathlib.RingTheory.Ideal.NatInt`, by Junyan Xu, identifies this ideal
with the maximal ideal of the local semiring `ℕ` and characterizes membership
as inequality to one. Its maximal-ideal API supplies primality and radicality.
-/

namespace Ideal

private theorem nat_span_two_three_isRadical :
    (Ideal.span ({2, 3} : Set ℕ)).IsRadical := by
  rw [← Nat.maximalIdeal_eq_span_two_three]
  exact (IsLocalRing.maximalIdeal.isMaximal ℕ).isPrime.isRadical

private theorem nat_span_two_three_not_subtractive :
    ¬ (∀ a b : ℕ, a ∈ Ideal.span ({2, 3} : Set ℕ) →
      a + b ∈ Ideal.span ({2, 3} : Set ℕ) →
      b ∈ Ideal.span ({2, 3} : Set ℕ)) := by
  rw [← Nat.maximalIdeal_eq_span_two_three]
  intro h
  exact Nat.mem_maximalIdeal_iff.mp (h 2 1 (by simp) (by simp)) rfl

private theorem nat_maximalIdeal_isRadical_and_not_map_C :
    (IsLocalRing.maximalIdeal ℕ).IsRadical ∧
      ¬ ((IsLocalRing.maximalIdeal ℕ).map
        (MvPolynomial.C : ℕ →+* MvPolynomial Unit ℕ)).IsRadical :=
  ⟨(IsLocalRing.maximalIdeal.isMaximal ℕ).isPrime.isRadical,
    MvPolynomial.not_isRadical_map_C_nat_maximalIdeal Unit⟩

end Ideal
