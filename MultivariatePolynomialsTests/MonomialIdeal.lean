module

import MultivariatePolynomials.MonomialIdeal

/-!
# Monomial-ideal coefficient examples

The variable exponents in countably many variables form an antichain. Over
`ℕ`, the coefficient identity applies to a sum with a higher-degree term,
not just to one of the monomial generators. If comparable exponents are
allowed, the ideal generated by `1` and a variable gives a counterexample.

## References

* `MultivariatePolynomials.MonomialIdeal` for the coefficient identity.
* Mathlib, `Mathlib.Algebra.MvPolynomial.Basic`, for variable coefficients.
-/

@[expose] public section

namespace MvPolynomial

local notation "V" => Set.range (fun i : ℕ => Finsupp.single i (1 : ℕ))

private theorem variableExponents_isAntichain : IsAntichain (· ≤ ·) V := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hne hle
  have hij : i = j := by
    by_contra h
    have hzero : (1 : ℕ) ≤ 0 := by
      simpa [Finsupp.single_apply, h, Ne.symm h] using hle i
    exact Nat.not_succ_le_zero 0 hzero
  exact hne (by rw [hij])

example :
    ((C 2 + X 1) * (X 0 + X 1 * X 0) : MvPolynomial ℕ ℕ).coeff
      (Finsupp.single 0 1) = 2 := by
  have hx : (X 0 : MvPolynomial ℕ ℕ) ∈
      Ideal.span ((fun s => monomial s (1 : ℕ)) '' V) :=
    Ideal.subset_span ⟨Finsupp.single 0 1, ⟨0, rfl⟩, rfl⟩
  have hp : (X 0 + X 1 * X 0 : MvPolynomial ℕ ℕ) ∈
      Ideal.span ((fun s => monomial s (1 : ℕ)) '' V) :=
    Ideal.add_mem _ hx (Ideal.mul_mem_left _ _ hx)
  rw [coeff_mul_of_mem_ideal_span_monomial variableExponents_isAntichain hp ⟨0, rfl⟩]
  simp [coeff_mul_X', coeff_X]

example :
    (1 : MvPolynomial ℕ ℕ) ∈ Ideal.span
      ((fun s => monomial s (1 : ℕ)) '' ({0, Finsupp.single 0 1} : Set (ℕ →₀ ℕ))) ∧
    ((X 0 : MvPolynomial ℕ ℕ) * 1).coeff (Finsupp.single 0 1) ≠
      (X 0 : MvPolynomial ℕ ℕ).coeff 0 *
        (1 : MvPolynomial ℕ ℕ).coeff (Finsupp.single 0 1) := by
  constructor
  · exact Ideal.subset_span ⟨0, by simp, by simp⟩
  · simp

end MvPolynomial
