module

public import MultivariatePolynomialsTests.Primary
public import MultivariatePolynomials.PrimaryDecomposition
import Mathlib.Tactic.FinCases

/-!
# Two essential primary components over the integers

The ideal `(12)` is the intersection of `(4)` and `(3)`. Both components
are primary, but `(4)` is not prime. The integers `3` and `4` witness that
neither component can be omitted.

The primary-family equivalence transports the intersection and primaryness
along `C`; deletion irredundance is transported by its lattice equivalence.
The integer equality uses
the Bezout identity `4 - 3 = 1`. The nonconstant witness is the square of
`2 * X`.

## References

* Mathlib's `Ideal.mul_eq_inf_of_isCoprime` supplies the coprime-ideal argument.
* `MvPolynomial.mem_map_C_iff_coeff_mem` and `MvPolynomial.isPrimary_map_C_iff`
  supply the coefficient-ideal facts.
* `MvPolynomial.primary_family_map_C_iff` and
  `MvPolynomial.irredundant_iInf_map_C_iff` transport the two family clauses.
* `Int.isPrimary_span_four` and `MvPolynomial.twice_X_span_four_facts` supply
  the primary component and its nonconstant square witness.
-/

@[expose] public section

namespace Int

/-- The two components `(4)` and `(3)` of the ideal `(12)`. -/
def twelveComponents (i : Fin 2) : Ideal ℤ :=
  if i = 0 then Ideal.span ({4} : Set ℤ) else Ideal.span ({3} : Set ℤ)

/-- The first component is `(4)`. -/
@[simp] theorem twelveComponents_zero :
    twelveComponents 0 = Ideal.span ({4} : Set ℤ) := by
  simp [twelveComponents]

/-- The second component is `(3)`. -/
@[simp] theorem twelveComponents_one :
    twelveComponents 1 = Ideal.span ({3} : Set ℤ) := by
  simp [twelveComponents]

/-- The ideal generated by three is prime. -/
theorem isPrime_span_three : (Ideal.span ({3} : Set ℤ)).IsPrime := by
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  exact (Int.ideal_span_isMaximal_of_prime 3).isPrime

/-- The coprime factors four and three give the intersection defining `(12)`. -/
theorem span_twelve_eq_inf_four_three :
    Ideal.span ({12} : Set ℤ) =
      Ideal.span ({4} : Set ℤ) ⊓ Ideal.span ({3} : Set ℤ) := by
  have hcoprime : IsCoprime (4 : ℤ) 3 := ⟨1, -1, by norm_num⟩
  calc
    Ideal.span ({12} : Set ℤ) =
        Ideal.span ({4} : Set ℤ) * Ideal.span ({3} : Set ℤ) := by
      simpa only [show (4 : ℤ) * 3 = 12 by norm_num] using
        (Ideal.span_singleton_mul_span_singleton (4 : ℤ) 3).symm
    _ = _ := Ideal.mul_eq_inf_of_isCoprime
      ((Ideal.isCoprime_span_singleton_iff (4 : ℤ) 3).mpr hcoprime)

/-- The square of two, but not two itself, belongs to `(4)`. -/
theorem span_four_square_witness :
    (2 : ℤ) ^ 2 ∈ Ideal.span ({4} : Set ℤ) ∧
      (2 : ℤ) ∉ Ideal.span ({4} : Set ℤ) := by
  norm_num [Ideal.mem_span_singleton]

private theorem span_four_not_isPrime :
    ¬ (Ideal.span ({4} : Set ℤ)).IsPrime := by
  intro h
  have hmul : (2 : ℤ) * 2 ∈ Ideal.span ({4} : Set ℤ) := by
    simpa only [pow_two] using span_four_square_witness.1
  exact (h.mem_or_mem hmul).elim span_four_square_witness.2 span_four_square_witness.2

/-- A two-component primary intersection with explicit deletion witnesses
and a component that is not prime. -/
theorem twelve_components_facts :
    Ideal.span ({12} : Set ℤ) = (⨅ i : Fin 2, twelveComponents i) ∧
      (∀ i, (twelveComponents i).IsPrimary) ∧
      (∀ i, ∃ x : ℤ, (∀ j, j ≠ i → x ∈ twelveComponents j) ∧
        x ∉ twelveComponents i) ∧
      ¬ (twelveComponents 0).IsPrime := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [span_twelve_eq_inf_four_three]
    apply le_antisymm
    · refine le_iInf fun i => ?_
      fin_cases i
      · simp [twelveComponents]
      · simp [twelveComponents]
    · refine le_inf ?_ ?_
      · simpa only [twelveComponents_zero] using (iInf_le twelveComponents 0)
      · simpa only [twelveComponents_one] using (iInf_le twelveComponents 1)
  · intro i
    fin_cases i
    · simpa [twelveComponents] using Int.isPrimary_span_four
    · simpa [twelveComponents] using isPrime_span_three.isPrimary
  · intro i
    fin_cases i
    · refine ⟨3, ?_, ?_⟩
      · intro j hj
        fin_cases j
        · exact (hj rfl).elim
        · norm_num [twelveComponents, Ideal.mem_span_singleton]
      · norm_num [twelveComponents, Ideal.mem_span_singleton]
    · refine ⟨4, ?_, ?_⟩
      · intro j hj
        fin_cases j
        · norm_num [twelveComponents, Ideal.mem_span_singleton]
        · exact (hj rfl).elim
      · norm_num [twelveComponents, Ideal.mem_span_singleton]
  · simpa [twelveComponents] using span_four_not_isPrime

end Int

namespace MvPolynomial

/-- The intersection `(12) = (4) ∩ (3)` over `ℤ[X]`, with essentiality
witnessed by constants and nonprimality witnessed by `2 * X`. -/
theorem twelve_components_facts :
    (Ideal.span ({12} : Set ℤ)).map (C : ℤ →+* MvPolynomial Unit ℤ) =
        (⨅ i : Fin 2, (Int.twelveComponents i).map C) ∧
      (∀ i, ((Int.twelveComponents i).map
        (C : ℤ →+* MvPolynomial Unit ℤ)).IsPrimary) ∧
      (∀ i, ∃ p : MvPolynomial Unit ℤ,
        (∀ j, j ≠ i → p ∈ (Int.twelveComponents j).map C) ∧
        p ∉ (Int.twelveComponents i).map C) ∧
      ¬ ((Int.twelveComponents 0).map (C : ℤ →+* MvPolynomial Unit ℤ)).IsPrime ∧
      ((C 2 * X () : MvPolynomial Unit ℤ) ^ 2 ∈
        (Int.twelveComponents 0).map C ∧
        (C 2 * X () : MvPolynomial Unit ℤ) ∉ (Int.twelveComponents 0).map C) := by
  have hw : (C 2 * X () : MvPolynomial Unit ℤ) ^ 2 ∈
        (Int.twelveComponents 0).map C ∧
      (C 2 * X () : MvPolynomial Unit ℤ) ∉ (Int.twelveComponents 0).map C := by
    simpa [Int.twelveComponents] using
      (And.intro twice_X_span_four_facts.1 twice_X_span_four_facts.2.1)
  have hfamily := (primary_family_map_C_iff (σ := Unit)
    (Ideal.span ({12} : Set ℤ)) Int.twelveComponents).mpr
      ⟨Int.twelve_components_facts.1, Int.twelve_components_facts.2.1⟩
  refine ⟨hfamily.1, hfamily.2, ?_, ?_, hw⟩
  · intro i
    obtain ⟨x, hx, hnot⟩ := Int.twelve_components_facts.2.2.1 i
    refine ⟨C x, ?_, ?_⟩
    · intro j hji
      exact Ideal.mem_map_of_mem C (hx j hji)
    · intro hp
      have hc := (mem_map_C_iff_coeff_mem.mp hp) 0
      exact hnot (by simpa only [coeff_zero_C] using hc)
  · intro h
    have hmul : (C 2 * X () : MvPolynomial Unit ℤ) * (C 2 * X ()) ∈
        (Int.twelveComponents 0).map C := by
      simpa only [pow_two] using hw.1
    exact (h.mem_or_mem hmul).elim hw.2 hw.2

/-- Neither component of `(12) = (4) ∩ (3)` over `ℤ[X]` can be deleted. -/
theorem twelve_components_irredundant :
    ∀ i : Fin 2, ¬ ((⨅ j : {j : Fin 2 // j ≠ i},
      (Int.twelveComponents j.val).map (C : ℤ →+* MvPolynomial Unit ℤ)) ≤
        (Int.twelveComponents i).map C) := by
  apply (irredundant_iInf_map_C_iff (σ := Unit) Int.twelveComponents).mpr
  intro i hle
  obtain ⟨x, hx, hnot⟩ := Int.twelve_components_facts.2.2.1 i
  exact hnot (hle (Ideal.mem_iInf.mpr fun j => hx j.val j.property))

end MvPolynomial
