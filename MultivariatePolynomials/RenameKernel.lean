module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Basic.Finite.Prod
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic.Choose

/-!
# Kernels of variable renaming

Renaming variables along an arbitrary function identifies the variables in each
fibre. Its kernel is the ideal generated by the corresponding variable differences.
The kernel is finitely generated exactly when the coefficient ring is subsingleton
or only finitely many source variables participate in a collision. Both indices of
each collision belong to this set; finiteness of each individual fibre is not enough.

Finite generation here is finite generation of an ideal over the source polynomial
ring, not finite generation as a module over the coefficient ring. The coefficient,
source-variable, and target-variable types may lie in independent universes.

## References

* Mathlib, `Mathlib.Algebra.MvPolynomial.Rename`: polynomial renaming.
* Mathlib, `Mathlib.RingTheory.Ideal.Maps`: kernels of ring homomorphisms.
* Mathlib, `Mathlib.RingTheory.Finiteness.Defs` and
  `Mathlib.RingTheory.Finiteness.Basic`: finite generation of ideals.
-/

@[expose] public section

universe u v w

namespace MvPolynomial

variable {R : Type u} {σ : Type v} {τ : Type w} [CommRing R]

/-- The kernel of renaming is generated by differences of variables with equal
images. Diagonal pairs contribute only the zero polynomial. -/
theorem ker_rename_eq_span_X_sub_X (f : σ → τ) :
    RingHom.ker (rename (R := R) f).toRingHom =
      Ideal.span {p : MvPolynomial σ R |
        ∃ i j : σ, f i = f j ∧ p = X i - X j} := by
  classical
  let I : Ideal (MvPolynomial σ R) :=
    Ideal.span {p : MvPolynomial σ R |
      ∃ i j : σ, f i = f j ∧ p = X i - X j}
  let q : MvPolynomial σ R →ₐ[R] MvPolynomial σ R ⧸ I := Ideal.Quotient.mkₐ R I
  have hq (i j : σ) (hij : f i = f j) : q (X i) = q (X j) := by
    simpa only [q, Ideal.Quotient.mkₐ_eq_mk] using
      (Ideal.Quotient.eq (I := I)).mpr
        (show X i - X j ∈ I from Ideal.subset_span ⟨i, j, hij, rfl⟩)
  -- Empty fibres are sent to zero, without choosing a default source variable.
  let g : τ → MvPolynomial σ R ⧸ I := fun t =>
    if h : ∃ i : σ, f i = t then q (X (Classical.choose h)) else 0
  have hg (i : σ) : g (f i) = q (X i) := by
    have hi : ∃ j : σ, f j = f i := ⟨i, rfl⟩
    dsimp only [g]
    rw [dite_eq_left hi]
    exact hq _ i (Classical.choose_spec hi)
  -- Agreement on variables gives the factorization of the quotient map.
  have hcomp : (aeval g).comp (rename (R := R) f) = q := by
    apply algHom_ext
    intro i
    simpa only [AlgHom.comp_apply, rename_X, aeval_X] using hg i
  have hqker : RingHom.ker q.toRingHom = I := Ideal.Quotient.mkₐ_ker R I
  apply le_antisymm
  · intro p hp
    have hp' : rename (R := R) f p = 0 := RingHom.mem_ker.mp hp
    have hpq : p ∈ RingHom.ker q.toRingHom := by
      apply RingHom.mem_ker.mpr
      calc
        q p = (aeval g) (rename (R := R) f p) := (AlgHom.congr_fun hcomp p).symm
        _ = 0 := by rw [hp', map_zero]
    exact hqker.le hpq
  · apply Ideal.span_le.mpr
    rintro p ⟨i, j, hij, rfl⟩
    apply (RingHom.sub_mem_ker_iff (rename (R := R) f).toRingHom).mpr
    simpa only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, rename_X] using
      congrArg (X (R := R)) hij

/-- The renaming kernel is finitely generated over the source polynomial ring
exactly when the coefficients are subsingleton or the source variables belonging
to nonsingleton fibres form a finite set. -/
theorem ker_rename_fg_iff (f : σ → τ) :
    (RingHom.ker (rename (R := R) f).toRingHom).FG ↔
      Subsingleton R ∨ Set.Finite {i : σ | ∃ j : σ, i ≠ j ∧ f i = f j} := by
  classical
  constructor
  · intro hfg
    rcases subsingleton_or_nontrivial R with hR | hR
    · exact Or.inl hR
    · let := hR
      right
      rw [ker_rename_eq_span_X_sub_X f] at hfg
      obtain ⟨T, hT, hspanSubmodule⟩ :=
        (Submodule.fg_span_iff_fg_span_finset_subset
          (R := MvPolynomial σ R)
          {p : MvPolynomial σ R | ∃ i j : σ, f i = f j ∧ p = X i - X j}).mp hfg
      have hspan : Ideal.span
          {p : MvPolynomial σ R | ∃ i j : σ, f i = f j ∧ p = X i - X j} =
          Ideal.span (T : Set (MvPolynomial σ R)) := hspanSubmodule
      have hw : ∀ p : {p : MvPolynomial σ R // p ∈ T},
          ∃ i j : σ, f i = f j ∧ (p : MvPolynomial σ R) = X i - X j :=
        fun p => hT p.property
      choose a b _ hpoly using hw
      let S : Finset σ := T.attach.biUnion fun p => {a p, b p}
      refine S.finite_toSet.subset ?_
      intro i hi
      obtain ⟨j, hij, hfij⟩ := hi
      by_contra hiS
      let evaluate : MvPolynomial σ R →+* R :=
        eval₂Hom (RingHom.id R) fun v => if v = i then 1 else 0
      have hker_le : RingHom.ker (rename (R := R) f).toRingHom ≤
          RingHom.ker evaluate := by
        rw [ker_rename_eq_span_X_sub_X f, hspan]
        refine Ideal.span_le.2 ?_
        intro p hp
        let q : {p : MvPolynomial σ R // p ∈ T} := ⟨p, hp⟩
        have ha : a q ∈ S :=
          Finset.mem_biUnion.2 ⟨q, Finset.mem_attach _ _, by simp⟩
        have hb : b q ∈ S :=
          Finset.mem_biUnion.2 ⟨q, Finset.mem_attach _ _, by simp⟩
        have hai : a q ≠ i := fun h => hiS (h ▸ ha)
        have hbi : b q ≠ i := fun h => hiS (h ▸ hb)
        change evaluate p = 0
        have hp' : p = X (a q) - X (b q) := hpoly q
        rw [hp']
        simp [evaluate, hai, hbi]
      have hmem : (X i - X j : MvPolynomial σ R) ∈
          RingHom.ker (rename (R := R) f).toRingHom := by
        rw [ker_rename_eq_span_X_sub_X f]
        exact Ideal.subset_span ⟨i, j, hfij, rfl⟩
      have heval : evaluate (X i - X j) = 0 := RingHom.mem_ker.mp (hker_le hmem)
      simp [evaluate, Ne.symm hij] at heval
  · rintro (hR | hfinite)
    · let := hR
      rw [RingHom.ker_eq_top_of_subsingleton]
      exact Ideal.fg_top (MvPolynomial σ R)
    · rw [ker_rename_eq_span_X_sub_X f]
      apply Submodule.fg_span
      refine ((Set.finite_singleton (0 : MvPolynomial σ R)).union
        ((hfinite.prod hfinite).image
          (fun ij : σ × σ => (X ij.1 - X ij.2 : MvPolynomial σ R)))).subset ?_
      rintro p ⟨i, j, hfij, rfl⟩
      by_cases hij : i = j
      · left
        simp [hij]
      · right
        exact ⟨(i, j), ⟨⟨j, hij, hfij⟩, ⟨i, Ne.symm hij, hfij.symm⟩⟩, rfl⟩

end MvPolynomial
