@[expose] public section

/-!
# Finite-presentation examples for polynomial renaming

Predecessor renaming is finitely presented over every commutative coefficient
ring, including the zero ring. With nontrivial coefficients its source polynomial
ring is not Noetherian. In contrast, projection from `ℕ × Bool` to `ℕ` is of
finite type but not finitely presented over any nontrivial commutative ring:
every source index participates in a collision, although each fibre has size two.

The elimination map between empty variable types allows independent coefficient,
source-variable, and target-variable universes. Over `ZMod 1`, the map
`(n, b) ↦ 2 * n` is finitely presented despite infinitely many missed target
indices and collision participants. Over `ZMod 4`, the nonzero square-zero
coefficient `2` accompanies the negative projection example; the coefficients
need not form a domain or a reduced ring.

Finite presentation and finite type use the algebra action induced by renaming
from the source polynomial ring. Kernel finite generation is for the source
ring acting on itself, not for the coefficient-ring module action. For the
negative projection example, the common base in the surjective-kernel theorem
is the source polynomial ring itself.

## References

* Mathlib, `Mathlib.RingTheory.FinitePresentation`: finite presentation of
  surjective ring homomorphisms and finite generation of their kernels.
* Mathlib, `Mathlib.RingTheory.FiniteType`: finite type of surjections.
* Mathlib, `Mathlib.Algebra.MvPolynomial.Rename`: surjectivity and injectivity
  of polynomial renaming.
* `MultivariatePolynomials.RenameKernel`: finite generation of renaming kernels.
* `MultivariatePolynomials.Noetherian`: finiteness of variables forced by
  Noetherianity of a polynomial ring with nontrivial coefficients.
* Mathlib, `Mathlib.Data.Set.Finite.Basic` and `Mathlib.Data.Nat.Init`:
  infinite ranges and separation of even and odd indices.
* Mathlib, `Mathlib.Data.ZMod.Basic`: the modular coefficient rings.

## Quotient model

The predecessor quotient identifies the first two variables and no others.
Its algebra equivalence is over the coefficient ring; finite presentation of
renaming instead uses the full source polynomial ring as scalar base.
Private examples retain the zero, nonreduced, non-Noetherian, and
independent-universe boundaries.
-/

universe u v w z

namespace MvPolynomial

variable {R : Type u} [CommRing R]

/-- Predecessor renaming has the principal kernel generated by `X 0 - X 1`. -/
theorem ker_rename_pred :
    RingHom.ker (rename (R := R) Nat.pred).toRingHom =
      Ideal.span ({X 0 - X 1} : Set (MvPolynomial ℕ R)) := by
  rw [ker_rename_eq_span_X_sub_X]
  let I : Ideal (MvPolynomial ℕ R) :=
    Ideal.span ({X 0 - X 1} : Set (MvPolynomial ℕ R))
  have hgen : X 0 - X 1 ∈ I := Ideal.subset_span (by simp)
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro p ⟨i, j, hij, rfl⟩
    cases i with
    | zero =>
      cases j with
      | zero => simp
      | succ j =>
        have hj : j = 0 := by simpa using hij.symm
        subst j
        exact hgen
    | succ i =>
      cases j with
      | zero =>
        have hi : i = 0 := by simpa using hij
        subst i
        change X 1 - X 0 ∈ I
        rw [← neg_sub]
        exact I.neg_mem hgen
      | succ j =>
        have hij' : i = j := by simpa using hij
        subst j
        simp
  · apply Ideal.span_le.mpr
    intro p hp
    obtain rfl := Set.mem_singleton_iff.mp hp
    exact Ideal.subset_span ⟨0, 1, rfl, rfl⟩

/-- Identifying the first two variables gives a polynomial algebra again, by predecessor
renaming. This is an equivalence over the coefficient ring, not a claim of finite
presentation over that coefficient ring. -/
noncomputable def renamePredQuotientEquiv (R : Type u) [CommRing R] :
    (MvPolynomial ℕ R ⧸ Ideal.span ({X 0 - X 1} : Set (MvPolynomial ℕ R))) ≃ₐ[R]
      MvPolynomial ℕ R :=
  (Ideal.quotientEquivAlgOfEq R (ker_rename_pred (R := R)).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (f := rename (R := R) Nat.pred)
      (rename_surjective Nat.pred (fun n => ⟨n + 1, rfl⟩)))

/-- The predecessor quotient equivalence acts by renaming representatives. -/
@[simp]
theorem renamePredQuotientEquiv_mk (p : MvPolynomial ℕ R) :
    renamePredQuotientEquiv R (Ideal.Quotient.mk _ p) = rename Nat.pred p := by
  rfl

/-- Successor renaming supplies representatives for the inverse equivalence. -/
@[simp]
theorem renamePredQuotientEquiv_symm_apply (q : MvPolynomial ℕ R) :
    (renamePredQuotientEquiv R).symm q =
      Ideal.Quotient.mk _ (rename (R := R) Nat.succ q) := by
  apply (renamePredQuotientEquiv R).injective
  rw [AlgEquiv.apply_symm_apply, renamePredQuotientEquiv_mk, rename_rename]
  exact (rename_id_apply q).symm

/-- An algebra map out of the predecessor quotient is determined by its action on
polynomial representatives. -/
theorem renamePredQuotientEquiv_unique
    (h : (MvPolynomial ℕ R ⧸ Ideal.span ({X 0 - X 1} : Set (MvPolynomial ℕ R))) →ₐ[R]
      MvPolynomial ℕ R)
    (hh : ∀ p, h (Ideal.Quotient.mk _ p) = rename Nat.pred p) :
    h = (renamePredQuotientEquiv R).toAlgHom := by
  apply AlgHom.ext
  intro x
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (hh p).trans (renamePredQuotientEquiv_mk p).symm

/-- Changing coefficients commutes with the predecessor quotient equivalence on
representatives. -/
theorem renamePredQuotientEquiv_map {S : Type z} [CommRing S] (φ : R →+* S)
    (p : MvPolynomial ℕ R) :
    renamePredQuotientEquiv S (Ideal.Quotient.mk _ (map φ p)) =
      map φ (renamePredQuotientEquiv R (Ideal.Quotient.mk _ p)) := by
  simpa only [renamePredQuotientEquiv_mk] using (map_rename φ Nat.pred p).symm

/-- Predecessor renaming is finitely presented over its full source polynomial ring,
for every commutative coefficient ring. -/
theorem finitePresentation_rename_pred :
    (rename (R := R) Nat.pred).toRingHom.FinitePresentation := by
  apply RingHom.FinitePresentation.of_surjective
    (rename (R := R) Nat.pred).toRingHom
  · intro q
    refine ⟨rename Nat.succ q, ?_⟩
    change rename Nat.pred (rename Nat.succ q) = q
    rw [← renamePredQuotientEquiv_mk, ← renamePredQuotientEquiv_symm_apply]
    exact (renamePredQuotientEquiv R).apply_symm_apply q
  · rw [ker_rename_pred]
    exact Submodule.fg_span_singleton _

/-- Projection with an infinite base and a nontrivial fibre is not finitely presented
for the algebra action of the full source polynomial ring. -/
theorem not_finitePresentation_rename_fst
    {σ : Type v} {β : Type w} [Nontrivial R] [Infinite σ] [Nontrivial β] :
    ¬ @Algebra.FinitePresentation (MvPolynomial (σ × β) R) (MvPolynomial σ R) _ _
      (rename (R := R) (Prod.fst : σ × β → σ)).toRingHom.toAlgebra := by
  intro hfp
  rcases (finitePresentation_rename_iff (R := R) (Prod.fst : σ × β → σ)).mp hfp with
    hR | ⟨_, hfinite⟩
  · exact (not_subsingleton R) hR
  · apply Set.infinite_univ (α := σ × β)
    apply hfinite.subset
    rintro ⟨n, b⟩ _
    obtain ⟨c, hc⟩ := exists_ne b
    exact ⟨(n, c), fun h => hc (congrArg Prod.snd h).symm, rfl⟩

end MvPolynomial

open MvPolynomial

namespace MultivariatePolynomialsTests

private theorem finitePresentation_rename_pred {R : Type u} [CommRing R] :
    @Algebra.FinitePresentation (MvPolynomial ℕ R) (MvPolynomial ℕ R) _ _
      (rename (R := R) Nat.pred).toRingHom.toAlgebra := by
  exact MvPolynomial.finitePresentation_rename_pred

private theorem renamePredQuotientEquiv_variables {R : Type u} [CommRing R] :
    renamePredQuotientEquiv R (Ideal.Quotient.mk _ (X 0)) = (X 0 : MvPolynomial ℕ R) ∧
      renamePredQuotientEquiv R (Ideal.Quotient.mk _ (X 1)) = (X 0 : MvPolynomial ℕ R) ∧
      renamePredQuotientEquiv R (Ideal.Quotient.mk _ (X 2)) = (X 1 : MvPolynomial ℕ R) := by
  simp

private theorem pred_source_not_isNoetherianRing
    {R : Type u} [CommRing R] [Nontrivial R] :
    ¬ IsNoetherianRing (MvPolynomial ℕ R) := by
  intro h
  let : IsNoetherianRing (MvPolynomial ℕ R) := h
  exact (Infinite.not_finite : ¬ Finite ℕ)
    (MvPolynomial.finite_of_isNoetherianRing (σ := ℕ) (R := R))

private theorem paired_rename_finiteType_not_finitePresentation
    {R : Type u} [CommRing R] [Nontrivial R] :
    @Algebra.FiniteType (MvPolynomial (ℕ × Bool) R) (MvPolynomial ℕ R) _ _
        (rename (R := R) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra ∧
      ¬ @Algebra.FinitePresentation (MvPolynomial (ℕ × Bool) R) (MvPolynomial ℕ R) _ _
        (rename (R := R) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra := by
  have hsurj : Function.Surjective
      (rename (R := R) (Prod.fst : ℕ × Bool → ℕ)) :=
    rename_surjective _ fun n => ⟨(n, false), rfl⟩
  let : Algebra (MvPolynomial (ℕ × Bool) R) (MvPolynomial ℕ R) :=
    (rename (R := R) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra
  constructor
  · exact RingHom.FiniteType.of_surjective
      (rename (R := R) (Prod.fst : ℕ × Bool → ℕ)).toRingHom hsurj
  · exact MvPolynomial.not_finitePresentation_rename_fst

private theorem finitePresentation_rename_pempty {R : Type u} [CommRing R] :
    @Algebra.FinitePresentation
      (MvPolynomial PEmpty.{v + 1} R) (MvPolynomial PEmpty.{w + 1} R) _ _
      (rename (R := R)
        (PEmpty.elim : PEmpty.{v + 1} → PEmpty.{w + 1})).toRingHom.toAlgebra := by
  let f := (rename (R := R)
    (PEmpty.elim : PEmpty.{v + 1} → PEmpty.{w + 1})).toRingHom
  let : Algebra (MvPolynomial PEmpty.{v + 1} R) (MvPolynomial PEmpty.{w + 1} R) :=
    f.toAlgebra
  have hbij : Function.Bijective f := by
    constructor
    · apply rename_injective
      intro i j _
      exact i.elim
    · apply rename_surjective
      intro j
      exact j.elim
  apply Algebra.FinitePresentation.of_surjective_algebraMap hbij.2
  change (RingHom.ker f).FG
  have hker : RingHom.ker f = ⊥ := by
    rw [← RingHom.injective_iff_ker_eq_bot]
    exact hbij.1
  rw [hker]
  exact Submodule.fg_bot

private theorem paired_even_zmod_one_finitePresentation :
    (Set.range (fun p : ℕ × Bool => 2 * p.1))ᶜ.Infinite ∧
      {i : ℕ × Bool | ∃ j : ℕ × Bool, i ≠ j ∧ 2 * i.1 = 2 * j.1}.Infinite ∧
      @Algebra.FinitePresentation
        (MvPolynomial (ℕ × Bool) (ZMod 1)) (MvPolynomial ℕ (ZMod 1)) _ _
        (rename (R := ZMod 1) (fun p : ℕ × Bool => 2 * p.1)).toRingHom.toAlgebra := by
  constructor
  · have hinj : Function.Injective (fun n : ℕ => 2 * n + 1) := by
      intro m n h
      exact mul_left_cancel₀ (by decide : (2 : ℕ) ≠ 0) (add_right_cancel h)
    apply Set.infinite_of_injective_forall_mem hinj
    intro n
    change 2 * n + 1 ∉ Set.range (fun p : ℕ × Bool => 2 * p.1)
    rintro ⟨⟨m, b⟩, h⟩
    exact Nat.two_mul_ne_two_mul_add_one h
  constructor
  · have hcollision :
        {i : ℕ × Bool | ∃ j : ℕ × Bool, i ≠ j ∧ 2 * i.1 = 2 * j.1} = Set.univ := by
      ext i
      simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]
      rcases i with ⟨n, b⟩
      exact ⟨(n, !b), fun h => Bool.self_ne_not b (congrArg Prod.snd h), rfl⟩
    rw [hcollision]
    exact Set.infinite_univ
  · let : Algebra (MvPolynomial (ℕ × Bool) (ZMod 1)) (MvPolynomial ℕ (ZMod 1)) :=
      (rename (R := ZMod 1) (fun p : ℕ × Bool => 2 * p.1)).toRingHom.toAlgebra
    apply Algebra.FinitePresentation.of_surjective_algebraMap
    · intro p
      exact ⟨0, Subsingleton.elim _ _⟩
    · rw [RingHom.ker_eq_top_of_subsingleton]
      exact Ideal.fg_top _

private theorem paired_rename_zmod_four :
    (2 : ZMod 4) ≠ 0 ∧ (2 : ZMod 4) ^ 2 = 0 ∧
      @Algebra.FiniteType
        (MvPolynomial (ℕ × Bool) (ZMod 4)) (MvPolynomial ℕ (ZMod 4)) _ _
        (rename (R := ZMod 4) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra ∧
      ¬ @Algebra.FinitePresentation
        (MvPolynomial (ℕ × Bool) (ZMod 4)) (MvPolynomial ℕ (ZMod 4)) _ _
        (rename (R := ZMod 4) (Prod.fst : ℕ × Bool → ℕ)).toRingHom.toAlgebra := by
  let : Nontrivial (ZMod 4) := ZMod.nontrivial_iff.mpr (by decide)
  exact ⟨by decide, by decide,
    paired_rename_finiteType_not_finitePresentation (R := ZMod 4)⟩

end MultivariatePolynomialsTests
