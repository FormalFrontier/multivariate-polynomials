module

public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.Minpoly.ConjRootClass
public import Mathlib.RingTheory.Spectrum.Maximal.Defs
public import Mathlib.RingTheory.Ideal.MonicSpan
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Algebraic-closure orbits and polynomial closed points

For an algebraic closure `L` of a field `K`, the orbits of `L` under its
`K`-algebra automorphisms are equivalent to the maximal spectrum of `K[X]`.
The orbit of an element maps to the ideal generated by its minimal polynomial.

The construction uses `ConjRootClass` and its minimal polynomial, identifying
its relation with the automorphism orbit relation by `Quotient.congrRight`.
Maximal ideals have monic irreducible generators, which acquire roots in `L`.
No separability assumption is needed, and the minimal polynomials retain their
multiplicities after scalar extension. This is an equivalence of sets only.

## References

This is the classical polynomial closed-point/Galois-orbit correspondence.
The formalization follows Mathlib contributors' conjugate-root,
normal-extension and minimal-polynomial theories:

* Mathlib, `Mathlib.FieldTheory.Minpoly.ConjRootClass` and
  `Mathlib.FieldTheory.Minpoly.IsConjRoot`, for conjugate-root classes, their
  minimal polynomials and the normal-extension automorphism criterion.
* Mathlib, `Mathlib.FieldTheory.IsAlgClosed.Basic`, for algebraic closures and
  existence of roots, and `Mathlib.FieldTheory.Minpoly.Field`, for identifying
  a monic irreducible polynomial with the minimal polynomial of a root.
* Mathlib, `Mathlib.RingTheory.Ideal.MonicSpan` and
  `Mathlib.RingTheory.PrincipalIdealDomain`, for the monic principal-ideal
  description of polynomial maximal ideals.
* Ravi Vakil, *The Rising Sea: Foundations of Algebraic Geometry*, October 21,
  2025 draft, for the algebraic-geometric context of polynomial closed points.
-/

@[expose] public section

universe u v

namespace Polynomial

variable (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]

/-- The orbits of an algebraic closure under its base-field algebra automorphisms
are equivalent to the maximal spectrum of the base polynomial ring. The orbit
of `a` corresponds to the ideal generated by `minpoly K a`.

This is the classical polynomial closed-point/Galois-orbit correspondence;
see Vakil's *The Rising Sea* for its algebraic-geometric context. The
construction follows Mathlib's `ConjRootClass`, normal-extension automorphism
criterion and minimal-polynomial formalizations, together with monic
maximal-ideal generators. -/
noncomputable def algAutOrbitEquivMaximalSpectrum [IsAlgClosure K L] :
    MulAction.orbitRel.Quotient (L ≃ₐ[K] L) L ≃ MaximalSpectrum (Polynomial K) := by
  letI : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  let f : ConjRootClass K L → MaximalSpectrum (Polynomial K) := fun c =>
    ⟨Ideal.span {c.minpoly},
      PrincipalIdealRing.isMaximal_of_irreducible c.irreducible_minpoly⟩
  have hf : Function.Bijective f := by
    constructor
    · intro c d h
      apply ConjRootClass.minpoly_inj.mp
      exact eq_of_monic_of_associated c.monic_minpoly d.monic_minpoly
        (Ideal.span_singleton_eq_span_singleton.mp
          (congrArg MaximalSpectrum.asIdeal h))
    · intro m
      obtain ⟨p, hpmonic, hp⟩ := exists_monic_span m.asIdeal
        (Ring.ne_bot_of_isMaximal_of_not_isField m.isMaximal (Polynomial.not_isField K))
      have hpirr : Irreducible p :=
        (Ideal.irreducible_iff_isMaximal_span_singleton hpmonic.ne_zero).mpr (by
          change (Ideal.span ({p} : Set (Polynomial K))).IsMaximal
          rw [← hp]
          exact m.isMaximal)
      obtain ⟨a, ha⟩ := IsAlgClosed.exists_aeval_eq_zero_of_injective L
        (algebraMap K L).injective p (ne_of_gt (degree_pos_of_irreducible hpirr))
      have hminpoly : p = minpoly K a :=
        minpoly.eq_of_irreducible_of_monic hpirr ha hpmonic
      refine ⟨ConjRootClass.mk K a, ?_⟩
      apply MaximalSpectrum.ext
      change Ideal.span ({minpoly K a} : Set (Polynomial K)) = m.asIdeal
      rw [← hminpoly, ← hp]
  exact
    (Quotient.congrRight
      (r := MulAction.orbitRel (L ≃ₐ[K] L) L)
      (r' := IsConjRoot.setoid K L)
      (fun a b => (isConjRoot_iff_orbitRel (K := K) (x := a) (y := b)).symm)).trans
      (Equiv.ofBijective f hf)

/-- The closed point of the automorphism orbit of `a` has ideal generated by
its minimal polynomial over `K`. -/
@[simp]
theorem algAutOrbitEquivMaximalSpectrum_asIdeal_mk [IsAlgClosure K L] (a : L) :
    (algAutOrbitEquivMaximalSpectrum K L
      (Quotient.mk (MulAction.orbitRel (L ≃ₐ[K] L) L) a)).asIdeal =
        Ideal.span ({minpoly K a} : Set (Polynomial K)) :=
  rfl

end Polynomial
