module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import MultivariatePolynomials.CoefficientIdeal
import Mathlib.RingTheory.Finiteness.Ideal

/-!
# Finite generation of coefficient and variable ideals

Over a nontrivial commutative semiring, the ideal generated by a subset of the
variables is finitely generated exactly when that subset is finite. The ambient
variable type need not be finite. In particular, the ideal generated by all
variables is not finitely generated when the variable type is infinite.

More generally, adding the extension of a proper coefficient ideal to the
all-variable ideal still gives an ideal that is not finitely generated. If
finitely many polynomials generated it, their variables would form a finite set.
Evaluate those variables at zero and a fresh variable at one. Each generator
evaluates to its constant coefficient, which lies in the coefficient ideal, but
the fresh variable evaluates to one, contradicting properness. This argument
requires neither additive inverses nor countably many variables.

For a coefficient ideal `I` and a subset `S` of the variables, the sum of the
extension of `I` along `C` and the span of `X '' S` is finitely generated exactly
when `I` is finitely generated and either `S` is finite or `I` is the unit ideal.
The coefficient semiring may be any commutative semiring, and the coefficient
and variable types may have independent universes.

Membership in this sum is tested coefficientwise at exactly those exponents
that vanish on the selected variables. This combines coefficient extension
with Mathlib's monomial-ideal membership criterion, without additive inverses.

Renaming variables sends the all-variable ideal to the ideal generated by
variables in the range of the index map, even when that map is not injective.
For a subtype inclusion, this identifies the ideal with the span of the
selected variables in the ambient polynomial semiring.

## References

* Ravi Vakil, *The Rising Sea: Foundations of Algebraic Geometry*, Exercise 6.7.E:
  motivation for the infinite-variable ideal statement (not the entire exercise).
* Eric Wieser's Mathlib module `Mathlib.RingTheory.MvPolynomial.Ideal`:
  `idealOfVars`, its finite-variable counterpart, and the subset membership
  criterion `mem_ideal_span_X_image`; `constantCoeff` is used in the
  all-variable proof.
* Mathlib's `Mathlib.Algebra.MvPolynomial.Rename`, by Johannes Hölzl,
  Johan Commelin and Mario Carneiro, and Kenny Lau's ideal-map APIs in
  `Mathlib.RingTheory.Ideal.Maps` identify a subset ideal with the image
  of the all-variable ideal on the subtype, and retract it to that ideal.
* `MultivariatePolynomials.CoefficientIdeal`: the coefficientwise membership
  criterion for extension along `C` over commutative semirings.
-/

@[expose] public section

universe u v w

namespace MvPolynomial

/-- A polynomial lies in the sum of an extended coefficient ideal and the
ideal generated by selected variables if and only if its coefficients at
exponents vanishing on those variables belong to the coefficient ideal. -/
theorem mem_map_C_sup_span_X_image_iff
    {σ : Type u} {R : Type v} [CommSemiring R]
    {I : Ideal R} {S : Set σ} {p : MvPolynomial σ R} :
    p ∈ Ideal.map (C : R →+* MvPolynomial σ R) I ⊔
      Ideal.span ((X : σ → MvPolynomial σ R) '' S) ↔
        ∀ d : σ →₀ ℕ, (∀ i ∈ S, d i = 0) → p.coeff d ∈ I := by
  classical
  constructor
  · intro hp
    rcases Submodule.mem_sup.mp hp with ⟨a, ha, b, hb, rfl⟩
    intro d hd
    have hbzero : b.coeff d = 0 := by
      by_contra hne
      obtain ⟨i, hi, hdi⟩ := mem_ideal_span_X_image.mp hb d (mem_support_iff.mpr hne)
      exact hdi (hd i hi)
    simpa [hbzero] using mem_map_C_iff_coeff_mem.mp ha d
  · intro hp
    rw [p.as_sum]
    refine Ideal.sum_mem _ fun d _ => ?_
    by_cases hd : ∀ i ∈ S, d i = 0
    · apply Submodule.mem_sup_left
      have hC : C (p.coeff d) ∈ Ideal.map (C : R →+* MvPolynomial σ R) I :=
        Ideal.mem_map_of_mem C (hp d hd)
      simpa only [C_mul_monomial, mul_one] using
        (Ideal.map (C : R →+* MvPolynomial σ R) I).mul_mem_right (monomial d 1) hC
    · apply Submodule.mem_sup_right
      simp only [not_forall] at hd
      obtain ⟨i, hi, hdi⟩ := hd
      apply mem_ideal_span_X_image.mpr
      intro m hm
      have hmd : m = d := Finset.mem_singleton.mp (support_monomial_subset hm)
      exact ⟨i, hi, hmd.symm ▸ hdi⟩

private theorem ideal_map_C_sup_span_X_image_map_constantCoeff
    {σ : Type u} {R : Type v} [CommSemiring R] (I : Ideal R) (S : Set σ) :
    (Ideal.map (C : R →+* MvPolynomial σ R) I ⊔
      Ideal.span ((X : σ → MvPolynomial σ R) '' S)).map constantCoeff = I := by
  have hvars : (Ideal.span ((X : σ → MvPolynomial σ R) '' S)).map constantCoeff = ⊥ := by
    apply le_antisymm ?_ bot_le
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, _, rfl⟩
    simp
  rw [Ideal.map_sup, Ideal.map_map, constantCoeff_comp_C (σ := σ) (R := R),
    Ideal.map_id, hvars, sup_bot_eq]

/-- Adding the extension of a proper coefficient ideal to the all-variable ideal
is not finitely generated when the variable type is infinite. This generalizes
the finite-support evaluation argument for the variable ideal motivated by
Vakil, *The Rising Sea*, Exercise 6.7.E, without requiring a nontrivial quotient
of the coefficient semiring. -/
theorem ideal_map_C_sup_idealOfVars_not_fg
    {σ : Type u} {R : Type v} [CommSemiring R] [Infinite σ]
    (I : Ideal R) (hI : I ≠ ⊤) :
    ¬ (Ideal.map (C : R →+* MvPolynomial σ R) I ⊔ idealOfVars σ R).FG := by
  classical
  rintro ⟨generators, hgenerators⟩
  let usedVars : Finset σ := generators.biUnion vars
  obtain ⟨fresh, hfresh⟩ := usedVars.exists_notMem
  let evaluate : MvPolynomial σ R →+* R :=
    eval₂Hom (RingHom.id R) fun i => if i ∈ usedVars then 0 else 1
  have sum_le_constantCoeff_comap :
      Ideal.map (C : R →+* MvPolynomial σ R) I ⊔ idealOfVars σ R ≤
        Ideal.comap constantCoeff I := by
    apply Ideal.map_le_iff_le_comap.mp
    exact le_of_eq (by
      simpa only [Set.image_univ, idealOfVars] using
        ideal_map_C_sup_span_X_image_map_constantCoeff I (Set.univ : Set σ))
  have generators_le_comap :
      Ideal.span (generators : Set (MvPolynomial σ R)) ≤ Ideal.comap evaluate I := by
    refine Ideal.span_le.2 ?_
    intro p hp
    change evaluate p ∈ I
    rw [eval₂Hom_eq_constantCoeff_of_vars]
    · have hpIdeal : p ∈ Ideal.map (C : R →+* MvPolynomial σ R) I ⊔
          idealOfVars σ R := by
        rw [← hgenerators]
        exact Ideal.subset_span hp
      exact sum_le_constantCoeff_comap hpIdeal
    · intro i hi
      have himem : i ∈ usedVars := Finset.mem_biUnion.2 ⟨p, hp, hi⟩
      simp only [himem, ite_true]
  have fresh_mem_span :
      X fresh ∈ Ideal.span (generators : Set (MvPolynomial σ R)) := by
    rw [hgenerators]
    exact Submodule.mem_sup_right (Ideal.subset_span ⟨fresh, rfl⟩)
  have fresh_mem_comap := generators_le_comap fresh_mem_span
  change evaluate (X fresh) ∈ I at fresh_mem_comap
  have hone : (1 : R) ∈ I := by
    simpa only [evaluate, eval₂Hom_X', hfresh, ite_false] using fresh_mem_comap
  exact hI ((Ideal.eq_top_iff_one I).mpr hone)

/-- The ideal generated by all variables is not finitely generated when the
variable type is infinite and the coefficient semiring is nontrivial.
Motivated by Vakil, *The Rising Sea*, Exercise 6.7.E; this proves only the
non-finite-generation statement, not the exercise's short exact sequence. -/
theorem idealOfVars_not_fg
    (k : Type*) (σ : Type*) [CommSemiring k] [Nontrivial k] [Infinite σ] :
    ¬ (idealOfVars σ k).FG := by
  simpa only [Ideal.map_bot, bot_sup_eq] using
    ideal_map_C_sup_idealOfVars_not_fg (σ := σ) (⊥ : Ideal k) bot_ne_top

/-- Renaming maps the all-variable ideal to the ideal generated by target
variables in the range of the index map. The map need not be injective. -/
theorem idealOfVars_map_rename
    {σ : Type u} {τ : Type v} {R : Type w} [CommSemiring R] (f : σ → τ) :
    (idealOfVars σ R).map (rename (R := R) f).toRingHom =
      Ideal.span ((X : τ → MvPolynomial τ R) '' Set.range f) := by
  rw [idealOfVars, Ideal.map_span, ← Set.range_comp]
  have hX : (rename (R := R) f).toRingHom ∘
      (X : σ → MvPolynomial σ R) = (X : τ → MvPolynomial τ R) ∘ f := by
    funext i
    exact rename_X _ i
  rw [hX, Set.range_comp]

private theorem idealOfVars_map_subtype_val
    {σ : Type u} {R : Type v} [CommSemiring R] (S : Set σ) :
    (idealOfVars S R).map (rename (R := R) (Subtype.val : S → σ)).toRingHom =
      Ideal.span ((X : σ → MvPolynomial σ R) '' S) := by
  simpa only [Subtype.range_val] using
    idealOfVars_map_rename (R := R) (Subtype.val : S → σ)

private theorem ideal_span_X_image_map_killCompl
    {σ : Type u} {R : Type v} [CommSemiring R] (S : Set σ) :
    (Ideal.span ((X : σ → MvPolynomial σ R) '' S)).map
      (killCompl (R := R) (f := (Subtype.val : S → σ)) Subtype.val_injective).toRingHom =
        idealOfVars S R := by
  rw [← idealOfVars_map_subtype_val S, Ideal.map_map]
  simp only [AlgHom.toRingHom_eq_coe]
  rw [← AlgHom.comp_toRingHom, killCompl_comp_rename, AlgHom.id_toRingHom, Ideal.map_id]

/-- The sum of a coefficient ideal extended along `C` and the ideal generated by
selected variables is finitely generated if and only if the coefficient ideal is
finitely generated and either the selected set is finite or the coefficient ideal
is the unit ideal. -/
theorem ideal_map_C_sup_span_X_image_fg_iff
    {σ : Type u} {R : Type v} [CommSemiring R] (I : Ideal R) (S : Set σ) :
    (Ideal.map (C : R →+* MvPolynomial σ R) I ⊔
      Ideal.span ((X : σ → MvPolynomial σ R) '' S)).FG ↔
        I.FG ∧ (S.Finite ∨ I = ⊤) := by
  constructor
  · intro hfg
    refine ⟨?_, ?_⟩
    · simpa only [ideal_map_C_sup_span_X_image_map_constantCoeff] using
        Ideal.FG.map hfg (constantCoeff : MvPolynomial σ R →+* R)
    · by_contra h
      have hS : ¬ S.Finite := fun hS => h (Or.inl hS)
      have hI : I ≠ ⊤ := fun hI => h (Or.inr hI)
      have : Infinite S := Set.infinite_coe_iff.mpr hS
      have hC :
          (killCompl (R := R) (f := (Subtype.val : S → σ))
            Subtype.val_injective).toRingHom.comp C = (C : R →+* MvPolynomial S R) := by
        apply RingHom.ext
        intro r
        exact killCompl_C (R := R) (f := (Subtype.val : S → σ)) Subtype.val_injective r
      have hfg' : (Ideal.map (C : R →+* MvPolynomial S R) I ⊔ idealOfVars S R).FG := by
        have hmap := Ideal.FG.map hfg
          (killCompl (R := R) (f := (Subtype.val : S → σ)) Subtype.val_injective).toRingHom
        rwa [Ideal.map_sup, Ideal.map_map, hC, ideal_span_X_image_map_killCompl] at hmap
      exact ideal_map_C_sup_idealOfVars_not_fg I hI hfg'
  · rintro ⟨hI, hS | rfl⟩
    · exact Submodule.FG.sup (Ideal.FG.map hI C) (Submodule.fg_span (hS.image X))
    · simpa only [Ideal.map_top, top_sup_eq] using Ideal.fg_top (MvPolynomial σ R)

/-- The ideal generated by a subset of the variables is finitely generated if and
only if that subset is finite, over any nontrivial commutative semiring.
Nontriviality is essential: over the zero semiring the ideal is finitely generated
for every subset of variables. -/
theorem ideal_span_X_image_fg_iff
    {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] (S : Set σ) :
    (Ideal.span ((MvPolynomial.X : σ → MvPolynomial σ R) '' S)).FG ↔ S.Finite := by
  have hbotFG : (⊥ : Ideal R).FG := Submodule.fg_bot
  have hbotProper : (⊥ : Ideal R) ≠ ⊤ := bot_ne_top
  simpa only [Ideal.map_bot, bot_sup_eq, hbotFG, true_and, hbotProper, or_false] using
    ideal_map_C_sup_span_X_image_fg_iff (⊥ : Ideal R) S

end MvPolynomial
