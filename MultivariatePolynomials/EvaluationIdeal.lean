module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.Algebra.MvPolynomial.Comap
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Coordinate differences and evaluation ideals

The ideal generated by the differences `X i - C (x i)` is the kernel of
evaluation at `x`. Membership is therefore characterized by vanishing at `x`.
Over a field this ideal also agrees with the singleton `vanishingIdeal`.
Evaluating the kernel at a second point gives the ideal generated by the
coordinate differences between the points. Their evaluation kernels sum to the
comap of this difference ideal, and are comaximal exactly when it is the unit ideal.
Polynomial substitution contracts evaluation kernels and coordinate-difference
ideals, and the corresponding field-valued points commute with spectrum comap.

## References

* Ravi Vakil, *The Rising Sea: Foundations of Algebraic Geometry*, §§3.2.5–6
  and Exercise 3.2.F, for the coordinate-generator setting; Exercise 3.2.P
  motivates polynomial point substitution. Neither exercise is asserted to
  state these general arbitrary-ring/variable results or the quotient repair.
* Mathlib, `Mathlib.RingTheory.MvPolynomial.Ideal` (evaluation and ideal APIs),
  `Mathlib.RingTheory.Nullstellensatz` (singleton vanishing ideals),
  `Mathlib.Algebra.MvPolynomial.Comap` (substitution and induced points), and
  `Mathlib.RingTheory.Spectrum.Prime.RingHom` (prime-spectrum comap).
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommRing R]

/-- The ideal of coordinate differences at a point is the kernel of evaluation
at that point, for arbitrary variable types and commutative coefficient rings.
Vakil, *The Rising Sea*, Exercise 3.2.F motivates the coordinate generators;
this arbitrary-ring/variable kernel equality uses Mathlib's polynomial and
quotient universal-property APIs, not a claimed published proof of this form. -/
theorem ideal_span_X_sub_C_eq_ker_eval (x : σ → R) :
    Ideal.span (Set.range (fun i : σ => X i - C (x i))) = RingHom.ker (eval x) := by
  let I : Ideal (MvPolynomial σ R) :=
    Ideal.span (Set.range (fun i : σ => X i - C (x i)))
  change I = RingHom.ker (eval x)
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro p ⟨i, rfl⟩
    simp [RingHom.mem_ker]
  · intro p hp
    have hX (i : σ) :
        Ideal.Quotient.mk I (X i) = Ideal.Quotient.mk I (C (x i)) := by
      apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem (X i) (C (x i))).2
      exact Ideal.subset_span (Set.mem_range_self i)
    have h : (Ideal.Quotient.mk I) =
        ((Ideal.Quotient.mk I).comp (C : R →+* MvPolynomial σ R)).comp (eval x) := by
      apply ringHom_ext
      · intro r
        simp
      · intro i
        simpa [RingHom.comp_apply] using hX i
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [RingHom.congr_fun h p]
    simp [RingHom.comp_apply, RingHom.mem_ker.mp hp]

/-- A polynomial lies in the ideal of coordinate differences at `x` exactly
when it vanishes at `x`. -/
theorem mem_ideal_span_X_sub_C_iff (x : σ → R) (p : MvPolynomial σ R) :
    p ∈ Ideal.span (Set.range (fun i : σ => X i - C (x i))) ↔ eval x p = 0 := by
  rw [ideal_span_X_sub_C_eq_ker_eval, RingHom.mem_ker]

/-- Evaluating the kernel at `b` at a point `a` generates the ideal of
coordinate differences `a i - b i`. The map is the ideal generated by the
images of the kernel, not merely its set-theoretic image. -/
theorem map_ker_eval_eq_span_sub (a b : σ → R) :
    Ideal.map (eval a) (RingHom.ker (eval b)) =
      Ideal.span (Set.range (fun i : σ => a i - b i)) := by
  rw [← ideal_span_X_sub_C_eq_ker_eval b, Ideal.map_span, ← Set.range_comp']
  simp only [map_sub, eval_X, eval_C]

/-- A pair of values is attained by evaluating one polynomial at `a` and `b`
exactly when their difference belongs to the ideal of coordinate differences. -/
theorem mem_range_eval_prod_iff (a b : σ → R) (r s : R) :
    (r, s) ∈ Set.range ((eval a).prod (eval b)) ↔
      r - s ∈ Ideal.span (Set.range (fun i : σ => a i - b i)) := by
  have ha : Function.Surjective (eval a) :=
    fun t => ⟨C t, eval_C (f := a) t⟩
  rw [← map_ker_eval_eq_span_sub a b,
    Ideal.mem_map_iff_of_surjective (eval a) ha]
  constructor
  · rintro ⟨p, hp⟩
    simp only [RingHom.prod_apply] at hp
    have hpa : eval a p = r := congrArg Prod.fst hp
    have hpb : eval b p = s := congrArg Prod.snd hp
    refine ⟨p - C s, ?_, ?_⟩
    · apply RingHom.mem_ker.mpr
      simp only [map_sub, eval_C, hpb, sub_self]
    · simp only [map_sub, eval_C, hpa]
  · rintro ⟨q, hq, hqa⟩
    refine ⟨q + C s, ?_⟩
    simp only [RingHom.prod_apply]
    apply Prod.ext
    · simp only [map_add, eval_C, hqa, sub_add_cancel]
    · simp only [map_add, eval_C, RingHom.mem_ker.mp hq, zero_add]

/-- The sum of the evaluation kernels at `a` and `b` is the comap along
`eval a` of the ideal generated by their coordinate differences. -/
theorem ker_eval_sup_ker_eval_eq_comap (a b : σ → R) :
    RingHom.ker (eval a) ⊔ RingHom.ker (eval b) =
      Ideal.comap (eval a) (Ideal.span (Set.range (fun i : σ => a i - b i))) := by
  rw [← map_ker_eval_eq_span_sub a b,
    Ideal.comap_map_of_surjective' (eval a)
      (fun r => ⟨C r, eval_C (f := a) r⟩)]
  exact sup_comm _ _

/-- Two evaluation kernels are comaximal exactly when the coordinate
differences between their points generate the unit ideal. -/
theorem ker_eval_sup_ker_eval_eq_top_iff (a b : σ → R) :
    (RingHom.ker (eval a) ⊔ RingHom.ker (eval b) = ⊤) ↔
      Ideal.span (Set.range (fun i : σ => a i - b i)) = ⊤ := by
  rw [ker_eval_sup_ker_eval_eq_comap a b, Ideal.comap_eq_top_iff]

/-- Over a field, the coordinate-difference ideal agrees with the singleton
vanishing ideal. Neither algebraic closure nor finitely many variables is needed. -/
theorem ideal_span_X_sub_C_eq_vanishingIdeal_singleton
    {k : Type u} [Field k] (x : σ → k) :
    Ideal.span (Set.range (fun i : σ => X i - C (x i))) = vanishingIdeal k {x} := by
  ext p
  rw [mem_ideal_span_X_sub_C_iff, mem_vanishingIdeal_singleton_iff]
  rfl

end MvPolynomial

namespace MvPolynomial

universe u v w z

variable {R : Type u} {S : Type v} {σ : Type w} {τ : Type z}
variable [CommSemiring R] [CommSemiring S] [Algebra R S]

/-- Pulling an evaluation kernel back along a polynomial algebra homomorphism
evaluates at the images of the source coordinates. The target point may take
values in a coefficient algebra. Vakil, *The Rising Sea*, Exercise 3.2.P
motivates point substitution, not this general kernel-comap statement. -/
theorem ker_aeval_comap (f : MvPolynomial σ R →ₐ[R] MvPolynomial τ R) (x : τ → S) :
    (RingHom.ker (aeval x).toRingHom).comap f.toRingHom =
      RingHom.ker (aeval (fun i => aeval x (f (X i)))).toRingHom := by
  rw [RingHom.comap_ker]
  change RingHom.ker (((aeval x).comp f).toRingHom) = _
  rw [aeval_unique ((aeval x).comp f)]
  rfl

end MvPolynomial

namespace MvPolynomial

universe u w z

variable {R : Type u} {σ : Type w} {τ : Type z} [CommRing R]

/-- A polynomial substitution pulls the coordinate-difference ideal back to
the coordinate-difference ideal at the substituted point. -/
theorem ideal_span_X_sub_C_comap
    (f : MvPolynomial σ R →ₐ[R] MvPolynomial τ R) (x : τ → R) :
    (Ideal.span (Set.range (fun i : τ => X i - C (x i)))).comap f.toRingHom =
      Ideal.span (Set.range (fun i : σ =>
        (X i : MvPolynomial σ R) - C (MvPolynomial.comap f x i))) := by
  rw [ideal_span_X_sub_C_eq_ker_eval, ideal_span_X_sub_C_eq_ker_eval]
  change (RingHom.ker (aeval x).toRingHom).comap f.toRingHom =
    RingHom.ker (aeval (comap f x)).toRingHom
  have hpoint : comap f x = fun i => aeval x (f (X i)) := by
    funext i
    exact comap_apply f x i
  rw [hpoint]
  exact ker_aeval_comap f x

end MvPolynomial

namespace MvPolynomial

universe u v w z

variable {k : Type u} {K : Type v} {σ : Type w} {τ : Type z}
variable [Field k] [Field K] [Algebra k K]

/-- Under polynomial substitution, contraction of the prime defined by a
field-valued point is the prime at the substituted point. -/
theorem pointToPoint_comap
    (f : MvPolynomial σ k →ₐ[k] MvPolynomial τ k) (x : τ → K) :
    PrimeSpectrum.comap f.toRingHom (pointToPoint (k := k) x) =
      pointToPoint (k := k) (fun i => aeval x (f (X i))) := by
  apply PrimeSpectrum.ext
  ext p
  change f p ∈ (vanishingIdeal k {x} : Ideal _) ↔
    p ∈ (vanishingIdeal k {fun i => aeval x (f (X i))} : Ideal _)
  have hcomp : (aeval x).comp f = aeval (fun i => aeval x (f (X i))) := by
    rw [aeval_unique ((aeval x).comp f)]
    rfl
  simpa only [mem_vanishingIdeal_singleton_iff, AlgHom.comp_apply] using
    (Iff.of_eq (congrArg (fun φ : MvPolynomial σ k →ₐ[k] K => φ p = 0) hcomp))

/-- For points valued in the coefficient field, polynomial substitution acts
on prime-spectrum points through `MvPolynomial.comap`. -/
theorem pointToPoint_comap_self
    (f : MvPolynomial σ k →ₐ[k] MvPolynomial τ k) (x : τ → k) :
    PrimeSpectrum.comap f.toRingHom (pointToPoint (k := k) x) =
      pointToPoint (k := k) (comap f x) := by
  have hpoint : comap f x = fun i => aeval x (f (X i)) := by
    funext i
    exact comap_apply f x i
  rw [hpoint]
  exact pointToPoint_comap f x

end MvPolynomial
