module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-!
# Homogeneous coordinate-power certificates

Let `p : J → MvPolynomial I R` be an arbitrarily indexed family of homogeneous
polynomials of a common degree `d`, with finitely many variables. If each variable
belongs to the radical of the ideal generated by `p`, there is one degree `M` and
finitely supported coefficient families `q : I → (J →₀ MvPolynomial I R)`, all
homogeneous of degree `M`, expressing every `X i ^ (M + d)` as
`(q i).sum (fun j r => r * p j)`.

For a field, it suffices that the only possible common zero over its algebraic
closure is the zero tuple. The coefficients of `q` remain in the original field.
When `J` has a `Fintype` instance, the function-sum corollaries give the same
identities as `∑ j, q (i, j) * p j`.

## Implementation notes

The radical criterion uses only a commutative semiring. The variable, generator
and coefficient types have independent universes. Only the variable type must
be finite, to choose a uniform degree; the generator type may be infinite.
Empty variable or generator types and degree zero are allowed; the geometric
hypothesis does not require the zero tuple itself to be a common zero.

Radical membership first gives a common exponent for the finitely many variables.
Projecting an ideal-span expression to its homogeneous component gives the common
coefficient degree. The finite-index corollaries use `Finsupp.sum_fintype`.
The field implication uses Mathlib's general Nullstellensatz over the algebraic closure.

## References

* Mathlib, `Mathlib.RingTheory.Ideal.Operations`:
  `Finsupp.mem_ideal_span_range_iff_exists_finsupp` gives finitely supported
  ideal-span expressions without a finite generator type.
* Mathlib, `Mathlib.RingTheory.GradedAlgebra.Basic` and
  `Mathlib.RingTheory.MvPolynomial.Homogeneous`: homogeneous decomposition and
  `DirectSum.coe_decompose_mul_add_of_right_mem` give the product projection law.
* Mathlib, `Mathlib.RingTheory.Nullstellensatz`:
  `MvPolynomial.vanishingIdeal_zeroLocus_eq_radical` identifies the radical with
  polynomials vanishing on the common zero locus over an algebraically closed extension.
-/

public section

namespace MvPolynomial

universe u v w

variable {I : Type u} {J : Type v} {R : Type w}

private theorem homogeneousComponent_mul_of_isHomogeneous_right [CommSemiring R]
    {a b : MvPolynomial I R} {m d : ℕ} (hb : b.IsHomogeneous d) :
    homogeneousComponent (m + d) (a * b) = homogeneousComponent m a * b := by
  let : GradedAlgebra (homogeneousSubmodule I R) := gradedAlgebra
  have h := DirectSum.coe_decompose_mul_add_of_right_mem
    (homogeneousSubmodule I R) (i := m) (a := a) hb
  change (decomposition.decompose' (a * b) (m + d) : MvPolynomial I R) =
    (decomposition.decompose' a m : MvPolynomial I R) * b at h
  simpa only [decomposition.decompose'_apply] using h

/-- A homogeneous system whose ideal has every variable in its radical admits
finitely supported homogeneous coefficient certificates for a common power of all
variables. The common coefficient degree is `M`, and the power is `M + d`.

This holds over commutative semirings, including trivial coefficients. Only the
variable type must be finite; the generator type is arbitrary. Empty variable and
generator types and degree zero are allowed. -/
theorem exists_homogeneous_finsupp_sum_mul_eq_X_pow [CommSemiring R] [Finite I]
    (p : J → MvPolynomial I R) (d : ℕ) (hp : ∀ j, (p j).IsHomogeneous d)
    (hrad : ∀ i, X i ∈ (Ideal.span (Set.range p)).radical) :
    ∃ (M : ℕ) (q : I → (J →₀ MvPolynomial I R)),
      (∀ i j, (q i j).IsHomogeneous M) ∧
      ∀ i, (q i).sum (fun j r => r * p j) = X i ^ (M + d) := by
  classical
  let : Fintype I := Fintype.ofFinite I
  choose n hn using fun i => Ideal.mem_radical_iff.mp (hrad i)
  let M := Finset.univ.sup n
  have hpower (i : I) : X i ^ (M + d) ∈ Ideal.span (Set.range p) := by
    have hni : n i ≤ M + d :=
      (Finset.le_sup (Finset.mem_univ i)).trans (Nat.le_add_right M d)
    simpa only [← pow_add, Nat.sub_add_cancel hni] using
      (Ideal.span (Set.range p)).mul_mem_left (X i ^ (M + d - n i)) (hn i)
  choose c hc using fun i =>
    Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp (hpower i)
  let q (i : I) : J →₀ MvPolynomial I R :=
    (c i).mapRange (homogeneousComponent M) (map_zero _)
  refine ⟨M, q, ?_, ?_⟩
  · intro i j
    change (homogeneousComponent M (c i j)).IsHomogeneous M
    exact homogeneousComponent_isHomogeneous M _
  · intro i
    calc
      (q i).sum (fun j r => r * p j) =
          (c i).sum (fun j r => homogeneousComponent M r * p j) :=
        Finsupp.sum_mapRange_index (fun _ => zero_mul _)
      _ = homogeneousComponent (M + d) ((c i).sum (fun j r => r * p j)) := by
        rw [map_finsuppSum]
        apply Finsupp.sum_congr
        intro j _
        exact (homogeneousComponent_mul_of_isHomogeneous_right (hp j)).symm
      _ = X i ^ (M + d) := by
        rw [hc i, homogeneousComponent_eq_self (isHomogeneous_X_pow i (M + d))]

/-- A homogeneous system over a field with no nonzero common zero over its
algebraic closure admits finitely supported homogeneous coordinate-power
certificates over the original field. No coefficients are chosen in the hypotheses.

Mathlib's `MvPolynomial.vanishingIdeal_zeroLocus_eq_radical` supplies the radical
membership needed by `exists_homogeneous_finsupp_sum_mul_eq_X_pow`. The variable
type is finite, but the generator type is arbitrary. Empty types and constant
systems are included: the zero tuple need not be a common zero. -/
theorem exists_homogeneous_finsupp_sum_mul_eq_X_pow_of_forall_aeval_eq_zero
    [Field R] [Finite I]
    (p : J → MvPolynomial I R) (d : ℕ) (hp : ∀ j, (p j).IsHomogeneous d)
    (hzero : ∀ x : I → AlgebraicClosure R, (∀ j, aeval x (p j) = 0) → x = 0) :
    ∃ (M : ℕ) (q : I → (J →₀ MvPolynomial I R)),
      (∀ i j, (q i j).IsHomogeneous M) ∧
      ∀ i, (q i).sum (fun j r => r * p j) = X i ^ (M + d) := by
  apply exists_homogeneous_finsupp_sum_mul_eq_X_pow p d hp
  intro i
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := AlgebraicClosure R),
    mem_vanishingIdeal_iff, zeroLocus_span]
  intro x hx
  have hxzero : x = 0 := hzero x fun j => hx (p j) ⟨j, rfl⟩
  simp only [aeval_X, hxzero, Pi.zero_apply]

/-- The finite-index function-sum form of
`exists_homogeneous_finsupp_sum_mul_eq_X_pow`, with coefficient family indexed by
`I × J`. The coefficient semiring may be trivial; empty types and degree zero
are allowed. -/
theorem exists_homogeneous_sum_mul_eq_X_pow [CommSemiring R] [Finite I] [Fintype J]
    (p : J → MvPolynomial I R) (d : ℕ) (hp : ∀ j, (p j).IsHomogeneous d)
    (hrad : ∀ i, X i ∈ (Ideal.span (Set.range p)).radical) :
    ∃ (M : ℕ) (q : I × J → MvPolynomial I R),
      (∀ a, (q a).IsHomogeneous M) ∧
      ∀ i, ∑ j, q (i, j) * p j = X i ^ (M + d) := by
  obtain ⟨M, q, hq, hpow⟩ := exists_homogeneous_finsupp_sum_mul_eq_X_pow p d hp hrad
  refine ⟨M, (fun a => q a.1 a.2), (fun a => hq a.1 a.2), ?_⟩
  intro i
  exact (Finsupp.sum_fintype (q i) (fun j r => r * p j) (fun _ => zero_mul _)).symm.trans
    (hpow i)

/-- The finite-index function-sum form of
`exists_homogeneous_finsupp_sum_mul_eq_X_pow_of_forall_aeval_eq_zero`, with
coefficient family indexed by `I × J`. Empty types and constant systems are
included, with no assumption that the zero tuple is a common zero. -/
theorem exists_homogeneous_sum_mul_eq_X_pow_of_forall_aeval_eq_zero
    [Field R] [Finite I] [Fintype J]
    (p : J → MvPolynomial I R) (d : ℕ) (hp : ∀ j, (p j).IsHomogeneous d)
    (hzero : ∀ x : I → AlgebraicClosure R, (∀ j, aeval x (p j) = 0) → x = 0) :
    ∃ (M : ℕ) (q : I × J → MvPolynomial I R),
      (∀ a, (q a).IsHomogeneous M) ∧
      ∀ i, ∑ j, q (i, j) * p j = X i ^ (M + d) := by
  obtain ⟨M, q, hq, hpow⟩ :=
    exists_homogeneous_finsupp_sum_mul_eq_X_pow_of_forall_aeval_eq_zero p d hp hzero
  refine ⟨M, (fun a => q a.1 a.2), (fun a => hq a.1 a.2), ?_⟩
  intro i
  exact (Finsupp.sum_fintype (q i) (fun j r => r * p j) (fun _ => zero_mul _)).symm.trans
    (hpow i)

end MvPolynomial
