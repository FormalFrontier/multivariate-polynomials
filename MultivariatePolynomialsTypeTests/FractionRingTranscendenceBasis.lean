/-!
# Complementary transcendence families in fraction rings

Let an injective renaming embed `R[τ]` into `R[σ]`, and let `L` and `K` be
fraction rings of these polynomial rings. The variables outside the renaming's
range form a transcendence basis over `L` when the `L`-action on `K` is the
canonical fraction-ring map of that same renaming. In particular, `K` is algebraic
over the `L`-subalgebra generated by the complementary localized variables.

The full equality of algebra maps fixes the coefficient semantics, not just the
images of selected variables. Examples use `ℤ[Unit]` and `ℤ[Bool]`, identity
renamings with empty complements, and independently lifted coefficient, index,
and fraction-ring types. A different action on the same fraction rings makes the
selected complementary variable a scalar and prevents it from being a basis.

## References

The scalar actions use Mathlib's `IsFractionRing.map`. Empty-family controls use
`algebraicIndependent_empty_type_iff` and
`AlgebraicIndependent.isTranscendenceBasis_iff_isAlgebraic`. The scalar relation
uses `AlgebraicIndependent.transcendental` and `transcendental_iff_injective`.
-/

@[expose] public section

universe uR uτ uσ uL uK

namespace MvPolynomial

section TwoVariables

local notation "P" => MvPolynomial Unit ℤ
local notation "Q" => MvPolynomial Bool ℤ

private theorem falseRenaming_injective :
    Function.Injective (fun (_ : Unit) => false) := by
  intro a b _
  exact Subsingleton.elim a b

private theorem trueRenaming_injective :
    Function.Injective (fun (_ : Unit) => true) := by
  intro a b _
  exact Subsingleton.elim a b

private noncomputable abbrev falseAction : Algebra (FractionRing P) (FractionRing Q) :=
  (IsFractionRing.map (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ)) (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => false)).toRingHom)
    (rename_injective _ falseRenaming_injective)).toAlgebra

private noncomputable abbrev trueAction : Algebra (FractionRing P) (FractionRing Q) :=
  (IsFractionRing.map (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ)) (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => true)).toRingHom)
    (rename_injective _ trueRenaming_injective)).toAlgebra

private theorem falseComplement_nonempty :
    Nonempty {i : Bool // i ∉ Set.range (fun (_ : Unit) => false)} :=
  ⟨⟨true, by simp⟩⟩

section CanonicalAction

attribute [local instance] falseAction

private theorem falseAction_fullMap :
    algebraMap (FractionRing P) (FractionRing Q) = IsFractionRing.map
    (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ)) (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => false)).toRingHom)
    (rename_injective _ falseRenaming_injective) := rfl

private theorem falseAction_polynomial (p : P) :
    algebraMap (FractionRing P) (FractionRing Q) (algebraMap P (FractionRing P) p) =
      algebraMap Q (FractionRing Q) (rename (fun (_ : Unit) => false) p) := by
  change IsFractionRing.map
    (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ))
    (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => false)).toRingHom)
    (rename_injective _ falseRenaming_injective) (algebraMap P (FractionRing P) p) = _
  simp only [IsFractionRing.map, IsLocalization.map_eq,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]

private theorem twoVariable_adjoin_isAlgebraic :
    Algebra.IsAlgebraic
      (Algebra.adjoin (FractionRing P) (Set.range
        (fun i : {i : Bool // i ∉ Set.range (fun (_ : Unit) => false)} =>
          algebraMap Q (FractionRing Q) (X i.1)))) (FractionRing Q) := by
  exact isAlgebraic_adjoin_fractionRing_map_rename_compl
    (R := ℤ) (L := FractionRing (MvPolynomial Unit ℤ))
    (K := FractionRing (MvPolynomial Bool ℤ)) (fun (_ : Unit) => false)
    falseRenaming_injective falseAction_fullMap

private theorem twoVariable_isTranscendenceBasis :
    IsTranscendenceBasis (FractionRing P)
      (fun i : {i : Bool // i ∉ Set.range (fun (_ : Unit) => false)} =>
        algebraMap Q (FractionRing Q) (X i.1)) := by
  exact isTranscendenceBasis_fractionRing_map_rename_compl
    (R := ℤ) (L := FractionRing (MvPolynomial Unit ℤ))
    (K := FractionRing (MvPolynomial Bool ℤ)) (fun (_ : Unit) => false)
    falseRenaming_injective falseAction_fullMap

end CanonicalAction

section OtherAction

attribute [local instance] trueAction

private theorem trueAction_fullMap :
    algebraMap (FractionRing P) (FractionRing Q) = IsFractionRing.map
    (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ)) (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => true)).toRingHom)
    (rename_injective _ trueRenaming_injective) := rfl

private theorem trueAction_X :
    algebraMap (FractionRing P) (FractionRing Q) (algebraMap P (FractionRing P) (X ())) =
      algebraMap Q (FractionRing Q) (X true) := by
  change IsFractionRing.map
    (A := P) (B := Q)
    (K := FractionRing (MvPolynomial Unit ℤ))
    (L := FractionRing (MvPolynomial Bool ℤ))
    (j := (rename (R := ℤ) (fun (_ : Unit) => true)).toRingHom)
    (rename_injective _ trueRenaming_injective) (algebraMap P (FractionRing P) (X ())) = _
  simp only [IsFractionRing.map, IsLocalization.map_eq,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, rename_X]

private theorem trueVariable_isScalar :
    algebraMap Q (FractionRing Q) (X true) ∈
      Set.range (algebraMap (FractionRing P) (FractionRing Q)) :=
  ⟨algebraMap P (FractionRing P) (X ()), trueAction_X⟩

private theorem scalarRelation_ne_zero :
    (Polynomial.X - Polynomial.C (algebraMap P (FractionRing P) (X ())) :
      Polynomial (FractionRing P)) ≠ 0 :=
  Polynomial.X_sub_C_ne_zero _

private theorem scalarRelation_aeval :
    Polynomial.aeval (algebraMap Q (FractionRing Q) (X true))
      (Polynomial.X - Polynomial.C (algebraMap P (FractionRing P) (X ())) :
        Polynomial (FractionRing P)) = 0 := by
  simp only [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, trueAction_X, sub_self]

private theorem wrongAction_not_isTranscendenceBasis :
    ¬ IsTranscendenceBasis (FractionRing P)
      (fun i : {i : Bool // i ∉ Set.range (fun (_ : Unit) => false)} =>
        algebraMap Q (FractionRing Q) (X i.1)) := by
  intro hBasis
  have ht : Transcendental (FractionRing P) (algebraMap Q (FractionRing Q) (X true)) :=
    hBasis.1.transcendental ⟨true, by simp⟩
  have hinj := transcendental_iff_injective.mp ht
  apply scalarRelation_ne_zero
  apply hinj
  simpa only [map_zero] using scalarRelation_aeval

end OtherAction
end TwoVariables

section IdentityRenamings

private theorem identityFractionMap (ι : Type uτ) :
    algebraMap (FractionRing (MvPolynomial ι ℤ)) (FractionRing (MvPolynomial ι ℤ)) =
      IsFractionRing.map (A := MvPolynomial ι ℤ) (B := MvPolynomial ι ℤ)
        (K := FractionRing (MvPolynomial ι ℤ)) (L := FractionRing (MvPolynomial ι ℤ))
        (j := (rename (R := ℤ) (id : ι → ι)).toRingHom)
        (rename_injective id Function.injective_id) := by
  apply IsLocalization.ringHom_ext (M := nonZeroDivisors (MvPolynomial ι ℤ))
  apply RingHom.ext
  intro p
  simp [RingHom.comp_apply, IsFractionRing.map,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]

private theorem identityComplement_empty (ι : Type uτ) :
    IsEmpty {i : ι // i ∉ Set.range (id : ι → ι)} :=
  ⟨fun i => i.2 ⟨i.1, rfl⟩⟩

-- Each element is already a scalar; this does not use either preceding headline.
private theorem self_adjoin_isAlgebraic {F : Type uL} [CommRing F] [Nontrivial F]
    {ι : Type uτ} (y : ι → F) :
    Algebra.IsAlgebraic (Algebra.adjoin F (Set.range y)) F := by
  refine ⟨fun x => ?_⟩
  have hx : x ∈ Algebra.adjoin F (Set.range y) :=
    (Algebra.adjoin F (Set.range y)).algebraMap_mem x
  exact isAlgebraic_algebraMap (⟨x, hx⟩ : Algebra.adjoin F (Set.range y))

private theorem empty_self_isTranscendenceBasis {F : Type uL}
    [CommRing F] [Nontrivial F] {ι : Type uτ} [IsEmpty ι] (y : ι → F) :
    IsTranscendenceBasis F y := by
  have hi : AlgebraicIndependent F y :=
    algebraicIndependent_empty_type_iff.mpr (Function.injective_id)
  exact hi.isTranscendenceBasis_iff_isAlgebraic.mpr (self_adjoin_isAlgebraic y)

private theorem unitIdentity_adjoin_isAlgebraic :
    Algebra.IsAlgebraic
      (Algebra.adjoin (FractionRing (MvPolynomial Unit ℤ)) (Set.range
        (fun i : {i : Unit // i ∉ Set.range (id : Unit → Unit)} =>
          algebraMap (MvPolynomial Unit ℤ) (FractionRing (MvPolynomial Unit ℤ))
            (X i.1)))) (FractionRing (MvPolynomial Unit ℤ)) := by
  exact self_adjoin_isAlgebraic _

private theorem unitIdentity_isTranscendenceBasis :
    IsTranscendenceBasis (FractionRing (MvPolynomial Unit ℤ))
      (fun i : {i : Unit // i ∉ Set.range (id : Unit → Unit)} =>
        algebraMap (MvPolynomial Unit ℤ) (FractionRing (MvPolynomial Unit ℤ))
          (X i.1)) := by
  exact isTranscendenceBasis_fractionRing_map_rename_compl
    (R := ℤ) id Function.injective_id (identityFractionMap Unit)

private theorem unitIdentity_stockBasis :
    IsTranscendenceBasis (FractionRing (MvPolynomial Unit ℤ))
      (fun i : {i : Unit // i ∉ Set.range (id : Unit → Unit)} =>
        algebraMap (MvPolynomial Unit ℤ) (FractionRing (MvPolynomial Unit ℤ))
          (X i.1)) := by
  letI := identityComplement_empty Unit
  exact empty_self_isTranscendenceBasis _

private theorem emptyIdentity_adjoin_isAlgebraic :
    Algebra.IsAlgebraic
      (Algebra.adjoin (FractionRing (MvPolynomial Empty ℤ)) (Set.range
        (fun i : {i : Empty // i ∉ Set.range (id : Empty → Empty)} =>
          algebraMap (MvPolynomial Empty ℤ) (FractionRing (MvPolynomial Empty ℤ))
            (X i.1)))) (FractionRing (MvPolynomial Empty ℤ)) := by
  exact self_adjoin_isAlgebraic _

private theorem emptyIdentity_isTranscendenceBasis :
    IsTranscendenceBasis (FractionRing (MvPolynomial Empty ℤ))
      (fun i : {i : Empty // i ∉ Set.range (id : Empty → Empty)} =>
        algebraMap (MvPolynomial Empty ℤ) (FractionRing (MvPolynomial Empty ℤ))
          (X i.1)) := by
  exact isTranscendenceBasis_fractionRing_map_rename_compl
    (R := ℤ) id Function.injective_id (identityFractionMap Empty)

private theorem emptyIdentity_stockBasis :
    IsTranscendenceBasis (FractionRing (MvPolynomial Empty ℤ))
      (fun i : {i : Empty // i ∉ Set.range (id : Empty → Empty)} =>
        algebraMap (MvPolynomial Empty ℤ) (FractionRing (MvPolynomial Empty ℤ))
          (X i.1)) := by
  exact empty_self_isTranscendenceBasis _

private theorem unitIdentity_adjoin_isFractionRing :
    IsFractionRing
      (Algebra.adjoin (FractionRing (MvPolynomial Unit ℤ)) (Set.range
        (fun i : {i : Unit // i ∉ Set.range (id : Unit → Unit)} =>
          algebraMap (MvPolynomial Unit ℤ) (FractionRing (MvPolynomial Unit ℤ))
            (X i.1)))) (FractionRing (MvPolynomial Unit ℤ)) := by
  exact isFractionRing_adjoin_fractionRing_map_rename_compl
    (R := ℤ) id Function.injective_id (identityFractionMap Unit)

private theorem emptyIdentity_adjoin_isFractionRing :
    IsFractionRing
      (Algebra.adjoin (FractionRing (MvPolynomial Empty ℤ)) (Set.range
        (fun i : {i : Empty // i ∉ Set.range (id : Empty → Empty)} =>
          algebraMap (MvPolynomial Empty ℤ) (FractionRing (MvPolynomial Empty ℤ))
            (X i.1)))) (FractionRing (MvPolynomial Empty ℤ)) := by
  exact isFractionRing_adjoin_fractionRing_map_rename_compl
    (R := ℤ) id Function.injective_id (identityFractionMap Empty)

end IdentityRenamings

section LiftedRealizations

private theorem liftedCoefficientDomain : IsDomain (ULift.{uR} ℤ) :=
  MulEquiv.isDomain ℤ (ULift.ringEquiv : ULift.{uR} ℤ ≃+* ℤ).toMulEquiv

attribute [local instance] liftedCoefficientDomain

private def liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool :=
  fun _ => ⟨false⟩

private theorem liftedRenaming_injective :
    Function.Injective (liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool) := by
  intro a b _
  exact Subsingleton.elim a b

private noncomputable abbrev liftedSourceAlgebra :
    Algebra (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))
      (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ)))) :=
  ((ULift.ringEquiv :
      ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))) ≃+*
        FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))).symm.toRingHom.comp
    (algebraMap (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))
      (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))).toAlgebra

attribute [local instance] liftedSourceAlgebra

private theorem liftedSourceFraction :
    IsFractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))
      (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ)))) :=
  IsLocalization.isLocalization_of_algEquiv _
    { (ULift.ringEquiv :
        ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))) ≃+*
          FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))).symm with
      commutes' := fun _ => rfl }

attribute [local instance] liftedSourceFraction

private noncomputable abbrev liftedTargetAlgebra :
    Algebra (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) :=
  ((ULift.ringEquiv :
      ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))) ≃+*
        FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))).symm.toRingHom.comp
    (algebraMap (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
      (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))).toAlgebra

attribute [local instance] liftedTargetAlgebra

private theorem liftedTargetFraction :
    IsFractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) :=
  IsLocalization.isLocalization_of_algEquiv _
    { (ULift.ringEquiv :
        ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))) ≃+*
          FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))).symm with
      commutes' := fun _ => rfl }

attribute [local instance] liftedTargetFraction

private noncomputable abbrev liftedFractionAction :
    Algebra
      (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) :=
  (IsFractionRing.map
    (A := MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))
    (B := MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
    (K := ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
    (L := ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
    (j := (rename (R := ULift.{uR} ℤ) liftedRenaming).toRingHom)
    (rename_injective liftedRenaming liftedRenaming_injective)).toAlgebra

attribute [local instance] liftedFractionAction

private theorem liftedComplement_nonempty :
    Nonempty {i : ULift.{uσ} Bool // i ∉ Set.range
      (liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool)} := by
  refine ⟨⟨⟨true⟩, ?_⟩⟩
  rintro ⟨a, ha⟩
  have h : false = true := congrArg ULift.down ha
  cases h

private theorem lifted_fullMap :
    algebraMap
      (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) =
    IsFractionRing.map
      (A := MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))
      (B := MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
      (K := ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
      (L := ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
      (j := (rename (R := ULift.{uR} ℤ) liftedRenaming).toRingHom)
      (rename_injective liftedRenaming liftedRenaming_injective) := rfl

private theorem lifted_adjoin_isAlgebraic :
    Algebra.IsAlgebraic
      (Algebra.adjoin
        (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
        (Set.range (fun i : {i : ULift.{uσ} Bool // i ∉ Set.range
            (liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool)} =>
          algebraMap (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
            (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
            (X i.1))))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) := by
  exact isAlgebraic_adjoin_fractionRing_map_rename_compl
    (R := ULift.{uR} ℤ)
    (L := ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
    (K := ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
    liftedRenaming liftedRenaming_injective lifted_fullMap

private theorem lifted_isTranscendenceBasis :
    IsTranscendenceBasis
      (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
      (fun i : {i : ULift.{uσ} Bool // i ∉ Set.range
          (liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool)} =>
        algebraMap (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
          (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
          (X i.1)) := by
  exact isTranscendenceBasis_fractionRing_map_rename_compl
    (R := ULift.{uR} ℤ)
    (L := ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
    (K := ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
    liftedRenaming liftedRenaming_injective lifted_fullMap

private theorem lifted_adjoin_isFractionRing :
    IsFractionRing
      (Algebra.adjoin
        (ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
        (Set.range (fun i : {i : ULift.{uσ} Bool // i ∉ Set.range
            (liftedRenaming : ULift.{uτ} Unit → ULift.{uσ} Bool)} =>
          algebraMap (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))
            (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
            (X i.1))))
      (ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ)))) := by
  exact isFractionRing_adjoin_fractionRing_map_rename_compl
    (R := ULift.{uR} ℤ)
    (L := ULift.{uL} (FractionRing (MvPolynomial (ULift.{uτ} Unit) (ULift.{uR} ℤ))))
    (K := ULift.{uK} (FractionRing (MvPolynomial (ULift.{uσ} Bool) (ULift.{uR} ℤ))))
    liftedRenaming liftedRenaming_injective lifted_fullMap

end LiftedRealizations

end MvPolynomial
